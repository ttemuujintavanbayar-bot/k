+/* The Windows-OS window apps: Terminal, Files, Task manager, Snake, 2048 and
+ * Minesweeper. Each one draws itself in its window's client area and gets the
+ * keys when its window has the keyboard ("Back: mouse" in the title bar). */
+
+#include <apps/apps_container.h>
+#include <ion.h>
+#include <ion/storage/file_system.h>
+#include <ion/timing.h>
+#include <stdarg.h>
+#include <string.h>
+
+#include "state.h"
+
+namespace Home {
+namespace Win {
+namespace Apps {
+
+namespace {
+
+using Ion::Events::Event;
+namespace Events = Ion::Events;
+using KDFont::Size::Small;
+using Ion::Storage::FileSystem;
+using Ion::Storage::Record;
+
+constexpr KDColor k_white = KDColor::RGB24(0xFFFFFF);
+
+uint32_t random(uint32_t n) { return n == 0 ? 0 : Ion::random() % n; }
+
+/* The calculator's libc has no printf: a small formatter for %d %u %lu %s %c
+ * and %%, with the '-' and '0' flags, a width and a precision for %s. */
+int fmt(char* out, int size, const char* f, ...) {
+  va_list args;
+  va_start(args, f);
+  int n = 0;
+  auto put = [&](char c) {
+    if (n < size - 1) {
+      out[n] = c;
+    }
+    n++;
+  };
+  for (; *f; f++) {
+    if (*f != '%') {
+      put(*f);
+      continue;
+    }
+    f++;
+    bool left = false, zero = false;
+    while (*f == '-' || *f == '0') {
+      left = left || *f == '-';
+      zero = zero || *f == '0';
+      f++;
+    }
+    int width = 0;
+    while (*f >= '0' && *f <= '9') {
+      width = width * 10 + (*f++ - '0');
+    }
+    int precision = -1;
+    if (*f == '.') {
+      f++;
+      precision = 0;
+      while (*f >= '0' && *f <= '9') {
+        precision = precision * 10 + (*f++ - '0');
+      }
+    }
+    bool isLong = false;
+    while (*f == 'l') {
+      isLong = true;
+      f++;
+    }
+    char digits[24];
+    const char* str = digits;
+    int len = 0;
+    if (*f == 'd' || *f == 'u') {
+      unsigned long v;
+      bool negative = false;
+      if (*f == 'd') {
+        long sv = isLong ? va_arg(args, long) : va_arg(args, int);
+        negative = sv < 0;
+        v = negative ? static_cast<unsigned long>(-sv)
+                     : static_cast<unsigned long>(sv);
+      } else {
+        v = isLong ? va_arg(args, unsigned long) : va_arg(args, unsigned);
+      }
+      char tmp[24];
+      int k = 0;
+      do {
+        tmp[k++] = '0' + v % 10;
+        v /= 10;
+      } while (v > 0);
+      if (negative) {
+        digits[len++] = '-';
+      }
+      while (k > 0) {
+        digits[len++] = tmp[--k];
+      }
+    } else if (*f == 's') {
+      str = va_arg(args, const char*);
+      if (str == nullptr) {
+        str = "";
+      }
+      len = strlen(str);
+      if (precision >= 0 && len > precision) {
+        len = precision;
+      }
+    } else if (*f == 'c') {
+      digits[0] = static_cast<char>(va_arg(args, int));
+      len = 1;
+    } else if (*f == '%') {
+      digits[0] = '%';
+      len = 1;
+    } else {
+      break;
+    }
+    int pad = width > len ? width - len : 0;
+    if (!left) {
+      for (int i = 0; i < pad; i++) {
+        put(zero && *f != 's' ? '0' : ' ');
+      }
+    }
+    for (int i = 0; i < len; i++) {
+      put(str[i]);
+    }
+    if (left) {
+      for (int i = 0; i < pad; i++) {
+        put(' ');
+      }
+    }
+  }
+  va_end(args);
+  if (size > 0) {
+    out[n < size ? n : size - 1] = 0;
+  }
+  return n;
+}
+
+// "HH:MM" -> true and the values
+bool parseTime(const char* s, int* h, int* m) {
+  int values[2] = {0, 0};
+  for (int k = 0; k < 2; k++) {
+    if (*s < '0' || *s > '9') {
+      return false;
+    }
+    while (*s >= '0' && *s <= '9') {
+      values[k] = values[k] * 10 + (*s++ - '0');
+    }
+    if (k == 0 && *s++ != ':') {
+      return false;
+    }
+  }
+  *h = values[0];
+  *m = values[1];
+  return true;
+}
+
+void formatInt(char* buffer, int size, int value) {
+  fmt(buffer, size, "%d", value);
+}
+
+/* ================================================================ 2048 */
+
+namespace G2048 {
+
+constexpr int k_cell = 33;
+constexpr int k_gap = 4;
+constexpr int k_board = 4 * k_cell + 5 * k_gap;  // 152
+constexpr int k_width = 276;
+constexpr int k_height = 160;
+
+void addTile(Game2048State& g) {
+  int empty[16];
+  int n = 0;
+  for (int i = 0; i < 16; i++) {
+    if (g.cells[i] == 0) {
+      empty[n++] = i;
+    }
+  }
+  if (n > 0) {
+    g.cells[empty[random(n)]] = random(10) == 0 ? 4 : 2;
+  }
+}
+
+void reset(Game2048State& g) {
+  memset(g.cells, 0, sizeof(g.cells));
+  g.score = 0;
+  g.over = false;
+  g.won = false;
+  addTile(g);
+  addTile(g);
+}
+
+bool canMove(const Game2048State& g) {
+  for (int i = 0; i < 16; i++) {
+    if (g.cells[i] == 0) {
+      return true;
+    }
+    if (i % 4 < 3 && g.cells[i] == g.cells[i + 1]) {
+      return true;
+    }
+    if (i < 12 && g.cells[i] == g.cells[i + 4]) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// direction: 0 left, 1 right, 2 up, 3 down
+bool move(Game2048State& g, int direction) {
+  bool moved = false;
+  for (int line = 0; line < 4; line++) {
+    int idx[4];
+    for (int k = 0; k < 4; k++) {
+      switch (direction) {
+        case 0:
+          idx[k] = line * 4 + k;
+          break;
+        case 1:
+          idx[k] = line * 4 + 3 - k;
+          break;
+        case 2:
+          idx[k] = k * 4 + line;
+          break;
+        default:
+          idx[k] = (3 - k) * 4 + line;
+          break;
+      }
+    }
+    uint16_t values[4] = {0, 0, 0, 0};
+    int n = 0;
+    for (int k = 0; k < 4; k++) {
+      if (g.cells[idx[k]]) {
+        values[n++] = g.cells[idx[k]];
+      }
+    }
+    uint16_t merged[4] = {0, 0, 0, 0};
+    int m = 0;
+    for (int k = 0; k < n; k++) {
+      if (k + 1 < n && values[k] == values[k + 1]) {
+        merged[m] = values[k] * 2;
+        g.score += merged[m];
+        if (merged[m] == 2048) {
+          g.won = true;
+        }
+        m++;
+        k++;
+      } else {
+        merged[m++] = values[k];
+      }
+    }
+    for (int k = 0; k < 4; k++) {
+      if (g.cells[idx[k]] != merged[k]) {
+        moved = true;
+        g.cells[idx[k]] = merged[k];
+      }
+    }
+  }
+  if (moved) {
+    addTile(g);
+    if (g.score > g.best) {
+      g.best = g.score;
+    }
+    g.over = !canMove(g);
+  }
+  return moved;
+}
+
+KDColor tileColor(int v) {
+  switch (v) {
+    case 2:
+      return KDColor::RGB24(0xEEE4DA);
+    case 4:
+      return KDColor::RGB24(0xEDE0C8);
+    case 8:
+      return KDColor::RGB24(0xF2B179);
+    case 16:
+      return KDColor::RGB24(0xF59563);
+    case 32:
+      return KDColor::RGB24(0xF67C5F);
+    case 64:
+      return KDColor::RGB24(0xF65E3B);
+    case 128:
+      return KDColor::RGB24(0xEDCF72);
+    case 256:
+      return KDColor::RGB24(0xEDCC61);
+    case 512:
+      return KDColor::RGB24(0xEDC850);
+    case 1024:
+      return KDColor::RGB24(0xEDC53F);
+    default:
+      return KDColor::RGB24(0xEDC22E);
+  }
+}
+
+Rect boardRect(Rect c) {
+  return {c.right() - k_board - 6, c.y + 4, k_board, k_board};
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  Game2048State& g = s.g2048;
+  fill(b, c, p.windowBack);
+  char buffer[24];
+  text(b, "2048", c.x + 12, c.y + 10, KDColor::RGB24(0xF59E3B),
+       KDFont::Size::Large);
+  fmt(buffer, sizeof(buffer), "Score %lu",
+           static_cast<unsigned long>(g.score));
+  text(b, buffer, c.x + 12, c.y + 40, p.text);
+  fmt(buffer, sizeof(buffer), "Best  %lu",
+           static_cast<unsigned long>(g.best));
+  text(b, buffer, c.x + 12, c.y + 58, p.textDim);
+  if (g.over) {
+    text(b, "Game over!", c.x + 12, c.y + 82, KDColor::RGB24(0xF67C5F));
+  } else if (g.won) {
+    text(b, "You win!", c.x + 12, c.y + 82, KDColor::RGB24(0xEDC22E));
+  }
+  text(b, focused ? "Arrows: move" : "OK: play", c.x + 12, c.y + 112,
+       p.textDim);
+  text(b, "OK: new game", c.x + 12, c.y + 130, p.textDim);
+  Rect board = boardRect(c);
+  roundFill(b, board, 6, KDColor::RGB24(0x2E2E2E));
+  for (int i = 0; i < 16; i++) {
+    Rect cell = {board.x + k_gap + (i % 4) * (k_cell + k_gap),
+                 board.y + k_gap + (i / 4) * (k_cell + k_gap), k_cell, k_cell};
+    if (!cell.intersects(b.clip())) {
+      continue;
+    }
+    int v = g.cells[i];
+    if (v == 0) {
+      roundFill(b, cell, 4, KDColor::RGB24(0x444444));
+      continue;
+    }
+    roundFill(b, cell, 4, tileColor(v));
+    formatInt(buffer, sizeof(buffer), v);
+    KDColor ink = v <= 4 ? KDColor::RGB24(0x5B524A) : k_white;
+    KDFont::Size f = v < 1000 ? KDFont::Size::Large : Small;
+    text(b, buffer, cell.x + k_cell / 2, cell.y + (k_cell - glyphHeight(f)) / 2,
+         ink, f, Align::Center, k_cell);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  Game2048State& g = s.g2048;
+  int direction = e == Events::Left    ? 0
+                  : e == Events::Right ? 1
+                  : e == Events::Up    ? 2
+                  : e == Events::Down  ? 3
+                                       : -1;
+  if (direction >= 0) {
+    if (!g.over && move(g, direction)) {
+      invalidate(c);
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    reset(g);
+    invalidate(c);
+    return true;
+  }
+  return false;
+}
