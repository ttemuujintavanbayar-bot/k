+/* ============================================================== Storage */
+
+namespace Storage {
+
+constexpr const char* k_extensions[] = {"py", "exp", "func", "seq", "lis",
+                                        "mat", "sys"};
+
+FileSystem* fs() { return FileSystem::sharedFileSystem; }
+
+// Files of the section: all calculator files, or only Python scripts
+int count(int section) {
+  if (section == 1) {
+    return fs()->numberOfRecordsWithExtension("py");
+  }
+  int n = 0;
+  for (const char* ext : k_extensions) {
+    n += fs()->numberOfRecordsWithExtension(ext);
+  }
+  return n;
+}
+
+Record at(int section, int index) {
+  if (section == 1) {
+    return fs()->recordWithExtensionAtIndex("py", index);
+  }
+  for (const char* ext : k_extensions) {
+    int n = fs()->numberOfRecordsWithExtension(ext);
+    if (index < n) {
+      return fs()->recordWithExtensionAtIndex(ext, index);
+    }
+    index -= n;
+  }
+  return Record();
+}
+
+bool find(const char* name, Record* result) {
+  int n = count(0);
+  for (int i = 0; i < n; i++) {
+    Record r = at(0, i);
+    const char* full = r.fullName();
+    if (full == nullptr) {
+      continue;
+    }
+    // Exact full name, or base name without extension
+    size_t len = strlen(name);
+    if (strcmp(full, name) == 0 ||
+        (strncmp(full, name, len) == 0 && full[len] == '.')) {
+      *result = r;
+      return true;
+    }
+  }
+  return false;
+}
+
+void sizeText(char* buffer, int size, size_t bytes) {
+  if (bytes < 1024) {
+    fmt(buffer, size, "%d B", static_cast<int>(bytes));
+  } else {
+    fmt(buffer, size, "%d.%d KB", static_cast<int>(bytes / 1024),
+             static_cast<int>((bytes % 1024) * 10 / 1024));
+  }
+}
+
+KDColor colorFor(const Record& r) {
+  if (r.hasExtension("py")) {
+    return KDColor::RGB24(0x5CC56A);
+  }
+  if (r.hasExtension("func") || r.hasExtension("seq")) {
+    return KDColor::RGB24(0x4FA3F7);
+  }
+  return KDColor::RGB24(0xF59E3B);
+}
+
+}  // namespace Storage
+
+/* =============================================================== Files */
+
+namespace Files {
+
+constexpr int k_width = 272;
+constexpr int k_height = 152;
+constexpr int k_sidebar = 82;
+constexpr int k_rowHeight = 16;
+constexpr int k_listY = 44;
+constexpr int k_visibleRows = 6;
+
+Rect buttonRect(Rect c, int i) {
+  int x = c.x + k_sidebar + 4 + i * 62;
+  return {x, c.y + 4, 58, 18};
+}
+
+Rect sideRect(Rect c, int i) {
+  return {c.x + 4, c.y + 24 + i * 22, k_sidebar - 8, 20};
+}
+
+Rect rowRect(Rect c, int i) {
+  return {c.x + k_sidebar + 2, c.y + k_listY + i * k_rowHeight,
+          c.w - k_sidebar - 6, k_rowHeight};
+}
+
+void fixSelection(Rect c) {
+  FilesState& f = s.files;
+  int n = Storage::count(f.section);
+  if (f.selected >= n) {
+    f.selected = n - 1;
+  }
+  if (f.selected < 0 && n > 0) {
+    f.selected = 0;
+  }
+  if (f.selected >= 0 && f.selected < f.scroll) {
+    f.scroll = f.selected;
+  }
+  if (f.selected >= f.scroll + k_visibleRows) {
+    f.scroll = f.selected - k_visibleRows + 1;
+  }
+  if (f.scroll > 0 && f.scroll + k_visibleRows > n) {
+    f.scroll = n > k_visibleRows ? n - k_visibleRows : 0;
+  }
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  FilesState& f = s.files;
+  fill(b, c, p.windowBack);
+  // Sidebar
+  fill(b, {c.x, c.y, k_sidebar, c.h}, p.titleInactive);
+  text(b, "This PC", c.x + 8, c.y + 5, p.textDim);
+  const char* sections[2] = {"Calculator", "Python"};
+  for (int i = 0; i < 2; i++) {
+    Rect r = sideRect(c, i);
+    if (f.section == i) {
+      roundFill(b, r, 4, p.button);
+      fill(b, {r.x, r.y + 5, 2, 10}, p.accent);
+    }
+    text(b, sections[i], r.x + 8, r.y + 3, p.text, Small, Align::Left,
+         r.w - 10);
+  }
+  // Buttons
+  const char* buttons[3] = {"Open", f.confirmDelete ? "Sure?" : "Delete",
+                            "Refresh"};
+  for (int i = 0; i < 3; i++) {
+    Rect r = buttonRect(c, i);
+    KDColor back = (i == 1 && f.confirmDelete) ? KDColor::RGB24(0xC42B1C)
+                                                : p.button;
+    roundFill(b, r, 4, back);
+    text(b, buttons[i], r.x + r.w / 2, r.y + 2, p.text, Small, Align::Center);
+  }
+  // Header
+  int listX = c.x + k_sidebar + 2;
+  text(b, "Name", listX + 22, c.y + 27, p.textDim);
+  text(b, "Size", c.right() - 52, c.y + 27, p.textDim);
+  // Rows
+  int n = Storage::count(f.section);
+  if (n == 0) {
+    text(b, "No files", listX + 22, c.y + k_listY + 4, p.textDim);
+  }
+  for (int i = 0; i < k_visibleRows; i++) {
+    int index = f.scroll + i;
+    if (index >= n) {
+      break;
+    }
+    Rect r = rowRect(c, i);
+    if (!r.intersects(b.clip())) {
+      continue;
+    }
+    Record record = Storage::at(f.section, index);
+    if (index == f.selected) {
+      roundFill(b, r, 3, focused ? KDColor::RGB24(0x2D4E6E) : p.button);
+    }
+    roundFill(b, {r.x + 6, r.y + 4, 8, 8}, 2, Storage::colorFor(record));
+    text(b, record.fullName(), r.x + 20, r.y + 1, p.text, Small, Align::Left,
+         r.w - 82);
+    char size[16];
+    Storage::sizeText(size, sizeof(size), record.value().size);
+    text(b, size, c.right() - 52, r.y + 1, p.textDim);
+  }
+  if (n > k_visibleRows) {
+    // Scroll indicator
+    int track = k_visibleRows * k_rowHeight;
+    int h = track * k_visibleRows / n;
+    int y = c.y + k_listY + track * f.scroll / n;
+    fill(b, {c.right() - 3, y, 2, h}, p.textDim);
+  }
+}
+
+void openSelected() {
+  FilesState& f = s.files;
+  if (f.selected < 0) {
+    return;
+  }
+  Record r = Storage::at(f.section, f.selected);
+  I18n::Message app = I18n::Message::CalculApp;
+  if (r.hasExtension("py")) {
+    app = I18n::Message::CodeApp;
+  } else if (r.hasExtension("func")) {
+    app = I18n::Message::FunctionApp;
+  } else if (r.hasExtension("seq")) {
+    app = I18n::Message::SequenceApp;
+  }
+  Item it;
+  if (itemByName(I18n::translate(app), &it)) {
+    requestLaunch(it);
+  }
+}
+
+void deleteSelected(Rect c) {
+  FilesState& f = s.files;
+  if (f.selected < 0) {
+    return;
+  }
+  if (!f.confirmDelete) {
+    f.confirmDelete = true;
+    invalidate(c);
+    return;
+  }
+  f.confirmDelete = false;
+  Record r = Storage::at(f.section, f.selected);
+  r.tryToDestroy();
+  fixSelection(c);
+  invalidate(c);
+}
+
+void click(int x, int y, bool right, Rect c) {
+  FilesState& f = s.files;
+  int ax = c.x + x, ay = c.y + y;
+  bool wasConfirm = f.confirmDelete;
+  f.confirmDelete = false;
+  for (int i = 0; i < 2; i++) {
+    if (sideRect(c, i).contains(ax, ay)) {
+      f.section = i;
+      f.selected = 0;
+      f.scroll = 0;
+      fixSelection(c);
+      invalidate(c);
+      return;
+    }
+  }
+  for (int i = 0; i < 3; i++) {
+    if (buttonRect(c, i).contains(ax, ay)) {
+      if (i == 0) {
+        openSelected();
+      } else if (i == 1) {
+        f.confirmDelete = wasConfirm;
+        deleteSelected(c);
+      } else {
+        fixSelection(c);
+      }
+      invalidate(c);
+      return;
+    }
+  }
+  int n = Storage::count(f.section);
+  for (int i = 0; i < k_visibleRows; i++) {
+    int index = f.scroll + i;
+    if (index < n && rowRect(c, i).contains(ax, ay)) {
+      if (f.selected == index && !right) {
+        openSelected();
+      }
+      f.selected = index;
+      invalidate(c);
+      return;
+    }
+  }
+  if (wasConfirm) {
+    invalidate(c);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  FilesState& f = s.files;
+  int n = Storage::count(f.section);
+  if (e == Events::Up || e == Events::Down) {
+    f.confirmDelete = false;
+    int next = f.selected + (e == Events::Up ? -1 : 1);
+    if (next >= 0 && next < n) {
+      f.selected = next;
+    }
+    fixSelection(c);
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right) {
+    f.section = e == Events::Left ? 0 : 1;
+    f.selected = 0;
+    f.scroll = 0;
+    f.confirmDelete = false;
+    fixSelection(c);
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    f.confirmDelete = false;
+    openSelected();
+    return true;
+  }
+  if (e == Events::Backspace) {
+    deleteSelected(c);
+    return true;
+  }
+  return false;
+}
+
+}  // namespace Files
+
+/* ======================================================== Task manager */
+
+namespace TaskManager {
+
+constexpr int k_width = 262;
+constexpr int k_height = 152;
+constexpr int k_rowHeight = 17;
+constexpr int k_visibleRows = 6;
+
+Rect tabRect(Rect c, int i) {
+  constexpr int widths[3] = {80, 96, 60};
+  int x = c.x + 6;
+  for (int k = 0; k < i; k++) {
+    x += widths[k] + 4;
+  }
+  return {x, c.y + 4, widths[i], 20};
+}
+
+Rect rowRect(Rect c, int i) {
+  return {c.x + 6, c.y + 30 + i * k_rowHeight, c.w - 12, k_rowHeight};
+}
+
+Rect endTaskRect(Rect c) { return {c.right() - 78, c.bottom() - 22, 72, 18}; }
+
+void bar(Band& b, Rect r, int permille, KDColor color) {
+  const Palette& p = palette();
+  fill(b, r, p.button);
+  fill(b, {r.x, r.y, r.w * permille / 1000, r.h}, color);
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  TaskManagerState& t = s.taskManager;
+  fill(b, c, p.windowBack);
+  const char* tabs[3] = {"Processes", "Performance", "Launch"};
+  for (int i = 0; i < 3; i++) {
+    Rect r = tabRect(c, i);
+    if (t.tab == i) {
+      roundFill(b, r, 4, KDColor::RGB24(0x2D4E6E));
+    }
+    text(b, tabs[i], r.x + r.w / 2, r.y + 3, t.tab == i ? p.text : p.textDim,
+         Small, Align::Center);
+  }
+  char buffer[40];
+  if (t.tab == 0) {
+    if (s.numberOfWindows == 0) {
+      text(b, "No open window", c.x + 10, c.y + 34, p.textDim);
+    }
+    for (int i = 0; i < s.numberOfWindows && i < k_visibleRows; i++) {
+      Rect r = rowRect(c, i);
+      if (i == t.selected) {
+        roundFill(b, r, 3, p.button);
+      }
+      WindowApp app = s.windows[i].app;
+      tile(b, icon(app), 14, r.x + 3, r.y + 1);
+      text(b, title(app), r.x + 22, r.y + 1, p.text);
+      text(b, s.windows[i].minimized ? "Minimized" : "Running",
+           r.right() - 4, r.y + 1, p.textDim, Small, Align::Right);
+    }
+    Rect end = endTaskRect(c);
+    bool enabled = t.selected >= 0 && t.selected < s.numberOfWindows;
+    roundFill(b, end, 4, enabled ? KDColor::RGB24(0xC42B1C) : p.button);
+    text(b, "End task", end.x + end.w / 2, end.y + 2,
+         enabled ? p.text : p.textDim, Small, Align::Center);
+  } else if (t.tab == 1) {
+    FileSystem* fs = FileSystem::sharedFileSystem;
+    size_t total = FileSystem::k_totalSize;
+    size_t used = total - fs->availableSize();
+    char a[12], u[12];
+    Storage::sizeText(u, sizeof(u), used);
+    Storage::sizeText(a, sizeof(a), total);
+    fmt(buffer, sizeof(buffer), "Storage  %s / %s", u, a);
+    text(b, buffer, c.x + 8, c.y + 30, p.text);
+    bar(b, {c.x + 8, c.y + 47, c.w - 16, 6},
+        static_cast<int>(used * 1000 / total), p.accent);
+    int pc = batteryPercent();
+    fmt(buffer, sizeof(buffer), "Battery  %d%%", pc);
+    text(b, buffer, c.x + 8, c.y + 60, p.text);
+    bar(b, {c.x + 8, c.y + 77, c.w - 16, 6}, pc * 10,
+        pc <= 15 ? KDColor::RGB24(0xE81123) : KDColor::RGB24(0x6CCB5F));
+    uint32_t up = uptimeSeconds();
+    fmt(buffer, sizeof(buffer), "Uptime  %d:%02d (min:sec)",
+             static_cast<int>(up / 60), static_cast<int>(up % 60));
+    text(b, buffer, c.x + 8, c.y + 92, p.text);
+    fmt(buffer, sizeof(buffer), "UI redraw  %d ms", s.lastRedrawMs);
+    text(b, buffer, c.x + 8, c.y + 110, p.text);
+    fmt(buffer, sizeof(buffer), "Open windows  %d", s.numberOfWindows);
+    text(b, buffer, c.x + 8, c.y + 128, p.text);
+  } else {
+    int n = numberOfAllItems();
+    for (int i = 0; i < k_visibleRows + 1; i++) {
+      int index = t.scroll + i;
+      if (index >= n) {
+        break;
+      }
+      Rect r = rowRect(c, i);
+      if (index == t.selected) {
+        roundFill(b, r, 3, focused ? KDColor::RGB24(0x2D4E6E) : p.button);
+      }
+      Item it = allItemAtIndex(index);
+      drawItemIcon(b, it, 14, r.x + 3, r.y + 1);
+      text(b, itemLabel(it), r.x + 22, r.y + 1, p.text, Small, Align::Left,
+           r.w - 26);
+    }
+  }
+}
+
+void endTask(Rect c) {
+  TaskManagerState& t = s.taskManager;
+  if (t.selected < 0 || t.selected >= s.numberOfWindows) {
+    return;
+  }
+  if (s.windows[t.selected].app == WindowApp::TaskManager) {
+    // Ending the task manager closes this very window
+    closeWindow(t.selected);
+    return;
+  }
+  closeWindow(t.selected);
+  if (t.selected >= s.numberOfWindows) {
+    t.selected = s.numberOfWindows - 1;
+  }
+  // The task manager window moved in the stack: redraw it where it is now
+  int me = windowIndexOf(WindowApp::TaskManager);
+  if (me >= 0) {
+    invalidate(clientRect(me));
+  }
+}
+
+void launchSelected() {
+  TaskManagerState& t = s.taskManager;
+  if (t.selected < 0 || t.selected >= numberOfAllItems()) {
+    return;
+  }
+  Item it = allItemAtIndex(t.selected);
+  if (it.kind == Item::Kind::Window) {
+    openWindow(static_cast<WindowApp>(it.index));
+  } else {
+    requestLaunch(it);
+  }
+}
+
+void click(int x, int y, bool right, Rect c) {
+  TaskManagerState& t = s.taskManager;
+  int ax = c.x + x, ay = c.y + y;
+  for (int i = 0; i < 3; i++) {
+    if (tabRect(c, i).contains(ax, ay)) {
+      t.tab = i;
+      t.selected = 0;
+      t.scroll = 0;
+      invalidate(c);
+      return;
+    }
+  }
+  if (t.tab == 0 && endTaskRect(c).contains(ax, ay)) {
+    endTask(c);
+    return;
+  }
+  int rows = t.tab == 2 ? k_visibleRows + 1 : k_visibleRows;
+  for (int i = 0; i < rows; i++) {
+    if (rowRect(c, i).contains(ax, ay)) {
+      int index = (t.tab == 2 ? t.scroll : 0) + i;
+      bool again = index == t.selected;
+      t.selected = index;
+      invalidate(c);
+      if (t.tab == 2 && again && !right) {
+        launchSelected();
+      }
+      return;
+    }
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  TaskManagerState& t = s.taskManager;
+  if (e == Events::Left || e == Events::Right) {
+    t.tab = (t.tab + (e == Events::Left ? 2 : 1)) % 3;
+    t.selected = 0;
+    t.scroll = 0;
+    invalidate(c);
+    return true;
+  }
+  int count = t.tab == 0 ? s.numberOfWindows
+                         : (t.tab == 2 ? numberOfAllItems() : 0);
+  if (e == Events::Up || e == Events::Down) {
+    int next = t.selected + (e == Events::Up ? -1 : 1);
+    if (next >= 0 && next < count) {
+      t.selected = next;
+    }
+    if (t.selected < t.scroll) {
+      t.scroll = t.selected;
+    }
+    if (t.selected > t.scroll + k_visibleRows) {
+      t.scroll = t.selected - k_visibleRows;
+    }
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (t.tab == 0) {
+      endTask(c);
+    } else if (t.tab == 2) {
+      launchSelected();
+    }
+    return true;
+  }
+  return false;
+}
+
+bool tick(Rect c) {
+  if (s.taskManager.tab == 1 && s.ticks % 3 == 0) {
+    invalidate({c.x, c.y + 26, c.w, c.h - 26});
+    return true;
+  }
+  return false;
+}
