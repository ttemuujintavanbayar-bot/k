+}  // namespace TaskManager
+
+/* ============================================================ Terminal */
+
+namespace Terminal {
+
+constexpr int k_width = 262;
+constexpr int k_height = 146;
+constexpr int k_lineHeight = 14;
+
+void print(const char* line) {
+  TerminalState& t = s.terminal;
+  // Wrap long lines
+  int len = strlen(line);
+  do {
+    for (int i = 0; i + 1 < TerminalState::k_lines; i++) {
+      memcpy(t.lines[i], t.lines[i + 1], sizeof(t.lines[i]));
+    }
+    int n = len > TerminalState::k_columns ? TerminalState::k_columns : len;
+    memcpy(t.lines[TerminalState::k_lines - 1], line, n);
+    t.lines[TerminalState::k_lines - 1][n] = 0;
+    line += n;
+    len -= n;
+  } while (len > 0);
+}
+
+void reset() {
+  TerminalState& t = s.terminal;
+  memset(t.lines, 0, sizeof(t.lines));
+  t.inputLength = 0;
+  t.input[0] = 0;
+  t.last[0] = 0;
+  print("Windows-OS Terminal [NumWorks]");
+  print("Type help. Alpha: letters/digits");
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  fill(b, c, KDColor::RGB24(0x0C0C0C));
+  const TerminalState& t = s.terminal;
+  KDColor ink = KDColor::RGB24(0xCCCCCC);
+  for (int i = 0; i < TerminalState::k_lines; i++) {
+    text(b, t.lines[i], c.x + 4, c.y + 2 + i * k_lineHeight, ink);
+  }
+  int y = c.y + 2 + TerminalState::k_lines * k_lineHeight;
+  char prompt[TerminalState::k_columns + 8];
+  fmt(prompt, sizeof(prompt), "C:\\> %s", t.input);
+  text(b, prompt, c.x + 4, y, k_white);
+  if (focused) {
+    int x = c.x + 4 + (5 + t.inputLength) * glyphWidth();
+    fill(b, {x, y + 11, 7, 2}, k_white);
+  }
+}
+
+bool startsWith(const char* s, const char* prefix) {
+  return strncmp(s, prefix, strlen(prefix)) == 0;
+}
+
+void run(const char* cmd, Rect c) {
+  char line[TerminalState::k_columns + 8];
+  fmt(line, sizeof(line), "C:\\> %s", cmd);
+  print(line);
+  while (*cmd == ' ') {
+    cmd++;
+  }
+  const char* arg = strchr(cmd, ' ');
+  while (arg && *arg == ' ') {
+    arg++;
+  }
+  if (cmd[0] == 0) {
+    return;
+  }
+  if (strcmp(cmd, "help") == 0) {
+    print("ls dir cat NAME rm NAME cls ver");
+    print("mem bat uptime time HH:MM apps");
+    print("open APP theme echo TEXT exit");
+  } else if (strcmp(cmd, "ls") == 0 || strcmp(cmd, "dir") == 0) {
+    int n = Storage::count(0);
+    if (n == 0) {
+      print("(no files)");
+    }
+    for (int i = 0; i < n; i++) {
+      Record r = Storage::at(0, i);
+      char size[12];
+      Storage::sizeText(size, sizeof(size), r.value().size);
+      fmt(line, sizeof(line), "%-24.24s %s", r.fullName(), size);
+      print(line);
+    }
+  } else if ((startsWith(cmd, "cat ") || startsWith(cmd, "type ")) && arg) {
+    Record r;
+    if (!Storage::find(arg, &r)) {
+      print("File not found");
+    } else {
+      Record::Data d = r.value();
+      const char* p = static_cast<const char*>(d.buffer);
+      size_t size = d.size;
+      // Python scripts start with one status byte
+      if (r.hasExtension("py") && size > 0) {
+        p++;
+        size--;
+      }
+      int shown = 0;
+      char out[TerminalState::k_columns + 1];
+      int n = 0;
+      for (size_t i = 0; i <= size && shown < 6; i++) {
+        char ch = i < size ? p[i] : '\n';
+        if (ch == 0) {
+          ch = '\n';
+        }
+        if (ch == '\n' || n == TerminalState::k_columns) {
+          out[n] = 0;
+          print(out);
+          shown++;
+          n = 0;
+          if (ch == 0 || i >= size) {
+            break;
+          }
+          if (ch != '\n') {
+            out[n++] = ch;
+          }
+        } else if (ch >= ' ' && ch < 127) {
+          out[n++] = ch;
+        }
+      }
+      if (shown >= 6) {
+        print("...");
+      }
+    }
+  } else if ((startsWith(cmd, "rm ") || startsWith(cmd, "del ")) && arg) {
+    Record r;
+    if (!Storage::find(arg, &r)) {
+      print("File not found");
+    } else {
+      print(r.tryToDestroy() ? "Deleted" : "Cannot delete");
+    }
+  } else if (strcmp(cmd, "cls") == 0 || strcmp(cmd, "clear") == 0) {
+    memset(s.terminal.lines, 0, sizeof(s.terminal.lines));
+  } else if (strcmp(cmd, "ver") == 0) {
+    fmt(line, sizeof(line), "Windows-OS on Epsilon %s",
+             Ion::softwareVersion());
+    print(line);
+  } else if (strcmp(cmd, "mem") == 0) {
+    FileSystem* fs = FileSystem::sharedFileSystem;
+    fmt(line, sizeof(line), "Storage: %d B free of %d B",
+             static_cast<int>(fs->availableSize()),
+             static_cast<int>(FileSystem::k_totalSize));
+    print(line);
+  } else if (strcmp(cmd, "bat") == 0) {
+    fmt(line, sizeof(line), "Battery %d%% (%d mV)%s", batteryPercent(),
+             static_cast<int>(Ion::Battery::voltage() * 1000),
+             Ion::Battery::isCharging() ? " charging" : "");
+    print(line);
+  } else if (strcmp(cmd, "uptime") == 0) {
+    uint32_t up = uptimeSeconds();
+    fmt(line, sizeof(line), "Up %d min %d s", static_cast<int>(up / 60),
+             static_cast<int>(up % 60));
+    print(line);
+  } else if (startsWith(cmd, "time")) {
+    int h, m;
+    if (arg && parseTime(arg, &h, &m) && h >= 0 && h < 24 &&
+        m >= 0 && m < 60) {
+      s.clockOffsetMinutes = static_cast<int16_t>(
+          h * 60 + m - static_cast<int>(uptimeSeconds() / 60));
+      invalidate({222, 214, 96, 24});
+    }
+    char clock[8];
+    clockText(clock);
+    fmt(line, sizeof(line), "Time is %s", clock);
+    print(line);
+  } else if (strcmp(cmd, "apps") == 0) {
+    int n = numberOfAllItems();
+    char row[TerminalState::k_columns + 1];
+    row[0] = 0;
+    for (int i = 0; i < n; i++) {
+      const char* label = itemLabel(allItemAtIndex(i));
+      if (strlen(row) + strlen(label) + 2 > TerminalState::k_columns) {
+        print(row);
+        row[0] = 0;
+      }
+      if (row[0]) {
+        strlcat(row, ", ", sizeof(row));
+      }
+      strlcat(row, label, sizeof(row));
+    }
+    if (row[0]) {
+      print(row);
+    }
+  } else if (startsWith(cmd, "open ") && arg) {
+    Item it;
+    if (itemByName(arg, &it)) {
+      if (it.kind == Item::Kind::Window) {
+        openWindow(static_cast<WindowApp>(it.index));
+      } else {
+        requestLaunch(it);
+      }
+    } else {
+      print("App not found (try apps)");
+    }
+  } else if (strcmp(cmd, "theme") == 0) {
+    s.theme = (s.theme + 1) % k_numberOfWallpapers;
+    prepareWallpaper(s.theme);
+    invalidateAll();
+  } else if (startsWith(cmd, "echo")) {
+    print(arg ? arg : "");
+  } else if (strcmp(cmd, "exit") == 0) {
+    int w = windowIndexOf(WindowApp::Terminal);
+    if (w >= 0) {
+      closeWindow(w);
+    }
+    return;
+  } else {
+    fmt(line, sizeof(line), "'%s' is not recognized", cmd);
+    print(line);
+  }
+  invalidate(c);
+}
+
+bool handleKey(Event e, Rect c) {
+  TerminalState& t = s.terminal;
+  if (e == Events::OK || e == Events::EXE) {
+    char cmd[sizeof(t.input)];
+    strlcpy(cmd, t.input, sizeof(cmd));
+    strlcpy(t.last, t.input, sizeof(t.last));
+    t.inputLength = 0;
+    t.input[0] = 0;
+    invalidate(c);
+    run(cmd, c);
+    return true;
+  }
+  if (e == Events::Backspace) {
+    if (t.inputLength > 0) {
+      t.input[--t.inputLength] = 0;
+      invalidate(c);
+    }
+    return true;
+  }
+  if (e == Events::Clear) {
+    t.inputLength = 0;
+    t.input[0] = 0;
+    invalidate(c);
+    return true;
+  }
+  if (e == Events::Up) {
+    strlcpy(t.input, t.last, sizeof(t.input));
+    t.inputLength = strlen(t.input);
+    invalidate(c);
+    return true;
+  }
+  const char* txt = e.text();
+  if (txt != nullptr && txt[0] != 0) {
+    for (const char* p = txt; *p; p++) {
+      if (*p >= ' ' && *p < 127 &&
+          t.inputLength < static_cast<int>(sizeof(t.input)) - 1) {
+        t.input[t.inputLength++] = *p;
+      }
+    }
+    t.input[t.inputLength] = 0;
+    invalidate(c);
+    return true;
+  }
+  return false;
+}
+
