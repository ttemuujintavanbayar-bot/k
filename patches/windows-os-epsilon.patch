+/* ------------------------------------------------------------------ items */
+
+struct BuiltinTile {
+  I18n::Message name;
+  uint8_t tile;
+};
+
+constexpr BuiltinTile k_builtinTiles[] = {
+    {I18n::Message::CalculApp, WinIcons::TileCalculation},
+    {I18n::Message::FunctionApp, WinIcons::TileGraph},
+    {I18n::Message::SolverApp, WinIcons::TileSolver},
+    {I18n::Message::StatsApp, WinIcons::TileStatistics},
+    {I18n::Message::DistributionsApp, WinIcons::TileDistributions},
+    {I18n::Message::SequenceApp, WinIcons::TileSequence},
+    {I18n::Message::RegressionApp, WinIcons::TileRegression},
+    {I18n::Message::InferenceApp, WinIcons::TileInference},
+    {I18n::Message::FinanceApp, WinIcons::TileFinance},
+    {I18n::Message::CodeApp, WinIcons::TileCode},
+    {I18n::Message::ElementsApp, WinIcons::TileElements},
+    {I18n::Message::SettingsApp, WinIcons::TileSettings},
+};
+
+constexpr int k_maxBuiltin = 20;
+int16_t s_builtin[k_maxBuiltin];  // app index in AppsContainer
+uint8_t s_builtinTile[k_maxBuiltin];
+I18n::Message s_builtinName[k_maxBuiltin];
+int s_numberOfBuiltin = 0;
+int s_numberOfGames = 0;
+
+const Escher::App::Descriptor* builtinDescriptor(int appIndex) {
+  return AppsContainer::sharedAppsContainer()
+      ->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+      ->descriptor();
+}
+
+void buildItems() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int appIndex = 1; appIndex < builtin && s_numberOfBuiltin < k_maxBuiltin;
+       appIndex++) {
+    I18n::Message name = builtinDescriptor(appIndex)->name();
+    uint8_t t = WinIcons::TileCode;
+    for (const BuiltinTile& bt : k_builtinTiles) {
+      if (bt.name == name) {
+        t = bt.tile;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = appIndex;
+    s_builtinTile[s_numberOfBuiltin] = t;
+    s_builtinName[s_numberOfBuiltin] = name;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfExternalApps();
+}
+
+Item builtinNamed(I18n::Message name) {
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    if (s_builtinName[i] == name) {
+      return {Item::Kind::Builtin, s_builtin[i]};
+    }
+  }
+  return k_noItem;
+}
+
+Item windowItem(WindowApp app) {
+  return {Item::Kind::Window, static_cast<int16_t>(app)};
+}
+
+bool itemIsValid(Item item) {
+  switch (item.kind) {
+    case Item::Kind::Builtin:
+      for (int i = 0; i < s_numberOfBuiltin; i++) {
+        if (s_builtin[i] == item.index) {
+          return true;
+        }
+      }
+      return false;
+    case Item::Kind::Window:
+      return item.index >= 0 && item.index < k_numberOfWindowApps;
+    case Item::Kind::External:
+      return item.index >= 0 && item.index < s_numberOfGames;
+    default:
+      return false;
+  }
+}
+
+// Pinned tiles of the start menu, like the reference
+constexpr int k_numberOfStartPins = 10;
+Item startPin(int i) {
+  constexpr I18n::Message k_builtinPins[] = {
+      I18n::Message::CalculApp, I18n::Message::FunctionApp,
+      I18n::Message::SolverApp, I18n::Message::StatsApp};
+  if (i < 4) {
+    return builtinNamed(k_builtinPins[i]);
+  }
+  constexpr WindowApp k_windowPins[] = {
+      WindowApp::Terminal, WindowApp::Files,    WindowApp::TaskManager,
+      WindowApp::Snake,    WindowApp::Game2048, WindowApp::Minesweeper};
+  return windowItem(k_windowPins[i - 4]);
+}
+
+char lower(char c) { return (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c; }
+
+bool matchesSearch(const char* label) {
+  if (s.searchLength == 0) {
+    return true;
+  }
+  for (const char* p = label; *p; p++) {
+    int k = 0;
+    while (k < s.searchLength && p[k] && lower(p[k]) == lower(s.search[k])) {
+      k++;
+    }
+    if (k == s.searchLength) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Items shown in the start grid (pinned, all apps, or search results)
+int startItemCount() {
+  if (s.searchLength == 0 && s.startTab == 0) {
+    int n = 0;
+    for (int i = 0; i < k_numberOfStartPins; i++) {
+      n += startPin(i).isNone() ? 0 : 1;
+    }
+    return n;
+  }
+  int n = 0;
+  int total = numberOfAllItems();
+  for (int i = 0; i < total; i++) {
+    n += matchesSearch(itemLabel(allItemAtIndex(i))) ? 1 : 0;
+  }
+  return n;
+}
+
+Item startItemAt(int index) {
+  if (s.searchLength == 0 && s.startTab == 0) {
+    for (int i = 0; i < k_numberOfStartPins; i++) {
+      Item it = startPin(i);
+      if (!it.isNone() && index-- == 0) {
+        return it;
+      }
+    }
+    return k_noItem;
+  }
+  int total = numberOfAllItems();
+  for (int i = 0; i < total; i++) {
+    Item it = allItemAtIndex(i);
+    if (matchesSearch(itemLabel(it)) && index-- == 0) {
+      return it;
+    }
+  }
+  return k_noItem;
+}
+
+int startPageCount() {
+  int n = startItemCount();
+  return n == 0 ? 1 : (n + k_gridPage - 1) / k_gridPage;
+}
+
+// Taskbar: pinned items, then open windows that are not pinned
+int taskItems(Item* items) {
+  int n = 0;
+  for (int i = 0; i < s.numberOfTaskbarPins && n < k_maxTaskItems; i++) {
+    items[n++] = s.taskbarPins[i];
+  }
+  for (int w = 0; w < s.numberOfWindows && n < k_maxTaskItems; w++) {
+    Item it = windowItem(s.windows[w].app);
+    bool found = false;
+    for (int i = 0; i < n; i++) {
+      found = found || items[i] == it;
+    }
+    if (!found) {
+      items[n++] = it;
+    }
+  }
+  return n;
+}
+
+bool isPinnedToTaskbar(Item item) {
+  for (int i = 0; i < s.numberOfTaskbarPins; i++) {
+    if (s.taskbarPins[i] == item) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void pinToTaskbar(Item item) {
+  if (isPinnedToTaskbar(item) || s.numberOfTaskbarPins >= k_maxTaskbarPins) {
+    return;
+  }
+  s.taskbarPins[s.numberOfTaskbarPins++] = item;
+}
+
+void unpinFromTaskbar(Item item) {
+  for (int i = 0; i < s.numberOfTaskbarPins; i++) {
+    if (s.taskbarPins[i] == item) {
+      for (int j = i; j + 1 < s.numberOfTaskbarPins; j++) {
+        s.taskbarPins[j] = s.taskbarPins[j + 1];
+      }
+      s.numberOfTaskbarPins--;
+      return;
+    }
+  }
+}
+
+/* -------------------------------------------------------------- hit test */
+
+enum class HitType : uint8_t {
+  None,
+  Desktop,
+  StartButton,
+  SearchButton,
+  TaskItem,
+  Tray,
+  StartPanel,
+  SearchBox,
+  TabPinned,
+  TabAll,
+  PagePrev,
+  PageNext,
+  StartItem,
+  StartSettings,
+  StartPower,
+  QuickPanel,
+  QuickButton,
+  QuickSlider,
+  ContextPanel,
+  ContextItem,
+  WindowTitle,
+  WindowMinimize,
+  WindowClose,
+  WindowClient,
+  Taskbar,
+};
+
+struct Hit {
+  HitType type;
+  int8_t index;   // item, button, window...
+  int16_t value;  // slider value
+  uint32_t key() const {
+    return (static_cast<uint32_t>(type) << 16) |
+           (static_cast<uint8_t>(index) << 8);
+  }
+};
+
+Rect contextRect() {
+  int h = 6 + s.numberOfContextItems * k_contextItemHeight;
+  int x = s.contextX;
+  int y = s.contextY - h;
+  if (y < 2) {
+    y = s.contextY + 2;
+  }
+  if (x + k_contextWidth > k_screenWidth - 2) {
+    x = k_screenWidth - 2 - k_contextWidth;
+  }
+  if (x < 2) {
+    x = 2;
+  }
+  return {x, y, k_contextWidth, h};
+}
+
+Rect contextItemRect(int i) {
+  Rect r = contextRect();
+  return {r.x + 3, r.y + 3 + i * k_contextItemHeight, r.w - 6,
+          k_contextItemHeight};
+}
+
+Rect taskItemRect(int i) {
+  return {k_taskItemX + i * k_taskItemStep, 214, 24, 24};
+}
+
+Rect gridCellRect(int i) {
+  return {k_gridX + (i % k_gridColumns) * k_gridCellWidth,
+          k_gridY + (i / k_gridColumns) * k_gridCellHeight, k_gridCellWidth,
+          k_gridCellHeight};
+}
+
+Rect quickButtonRect(int i) {
+  return {k_qsButtonX + (i % 3) * (k_qsButtonWidth + 4),
+          k_qsButtonY + (i / 3) * (k_qsButtonHeight + 6), k_qsButtonWidth,
+          k_qsButtonHeight};
+}
+
+Rect quickSliderHitRect(int i) {
+  return {k_qsSliderX - 8, k_qsSliderY + i * k_qsSliderStep - 8,
+          k_qsSliderWidth + 16, 18};
+}
+
+Rect titleButtonRect(int windowIndex, bool close) {
+  Rect r = windowRect(windowIndex);
+  return {r.right() - (close ? 24 : 48), r.y, 24, k_titleHeight};
+}
+
+Hit hitTest(int x, int y) {
+  // Menus are on top
+  if (s.menu == Menu::Context) {
+    Rect r = contextRect();
+    if (r.contains(x, y)) {
+      for (int i = 0; i < s.numberOfContextItems; i++) {
+        if (contextItemRect(i).contains(x, y)) {
+          return {HitType::ContextItem, static_cast<int8_t>(i), 0};
+        }
+      }
+      return {HitType::ContextPanel, 0, 0};
+    }
+  } else if (s.menu == Menu::Start && k_startMenu.contains(x, y)) {
+    if (k_searchBox.contains(x, y)) {
+      return {HitType::SearchBox, 0, 0};
+    }
+    if (s.searchLength == 0 && k_tabPinned.contains(x, y)) {
+      return {HitType::TabPinned, 0, 0};
+    }
+    if (s.searchLength == 0 && k_tabAll.contains(x, y)) {
+      return {HitType::TabAll, 0, 0};
+    }
+    if (startPageCount() > 1) {
+      if (k_pagePrev.contains(x, y)) {
+        return {HitType::PagePrev, 0, 0};
+      }
+      if (k_pageNext.contains(x, y)) {
+        return {HitType::PageNext, 0, 0};
+      }
+    }
+    int count = startItemCount();
+    for (int i = 0; i < k_gridPage; i++) {
+      if (s.startPage * k_gridPage + i < count &&
+          gridCellRect(i).contains(x, y)) {
+        return {HitType::StartItem, static_cast<int8_t>(i), 0};
+      }
+    }
+    if (k_startSettings.contains(x, y)) {
+      return {HitType::StartSettings, 0, 0};
+    }
+    if (k_startPower.contains(x, y)) {
+      return {HitType::StartPower, 0, 0};
+    }
+    return {HitType::StartPanel, 0, 0};
+  } else if (s.menu == Menu::QuickSettings && k_quickSettings.contains(x, y)) {
+    for (int i = 0; i < 6; i++) {
+      if (quickButtonRect(i).contains(x, y)) {
+        return {HitType::QuickButton, static_cast<int8_t>(i), 0};
+      }
+    }
+    for (int i = 0; i < 2; i++) {
+      if (quickSliderHitRect(i).contains(x, y)) {
+        int v = (x - k_qsSliderX) * 1000 / k_qsSliderWidth;
+        v = v < 0 ? 0 : (v > 1000 ? 1000 : v);
+        return {HitType::QuickSlider, static_cast<int8_t>(i),
+                static_cast<int16_t>(v)};
+      }
+    }
+    return {HitType::QuickPanel, 0, 0};
+  }
+  // Taskbar
+  if (k_taskbar.contains(x, y)) {
+    if (k_startButton.contains(x, y)) {
+      return {HitType::StartButton, 0, 0};
+    }
+    if (k_searchButton.contains(x, y)) {
+      return {HitType::SearchButton, 0, 0};
+    }
+    Item items[k_maxTaskItems];
+    int n = taskItems(items);
+    for (int i = 0; i < n; i++) {
+      if (taskItemRect(i).contains(x, y)) {
+        return {HitType::TaskItem, static_cast<int8_t>(i), 0};
+      }
+    }
+    if (k_trayButton.contains(x, y)) {
+      return {HitType::Tray, 0, 0};
+    }
+    return {HitType::Taskbar, 0, 0};
+  }
+  // Windows, from the top
+  for (int w = s.numberOfWindows - 1; w >= 0; w--) {
+    if (s.windows[w].minimized || !windowRect(w).contains(x, y)) {
+      continue;
+    }
+    if (titleButtonRect(w, true).contains(x, y)) {
+      return {HitType::WindowClose, static_cast<int8_t>(w), 0};
+    }
+    if (titleButtonRect(w, false).contains(x, y)) {
+      return {HitType::WindowMinimize, static_cast<int8_t>(w), 0};
+    }
+    if (y < windowRect(w).y + k_titleHeight) {
+      return {HitType::WindowTitle, static_cast<int8_t>(w), 0};
+    }
+    return {HitType::WindowClient, static_cast<int8_t>(w), 0};
+  }
+  return {HitType::Desktop, 0, 0};
+}
+
+// Area to redraw when the hover state of this hit changes
+Rect hoverRect(Hit h) {
+  switch (h.type) {
+    case HitType::StartButton:
+      return k_startButton;
+    case HitType::SearchButton:
+      return k_searchButton;
+    case HitType::TaskItem:
+      return taskItemRect(h.index);
+    case HitType::Tray:
+      return k_trayButton;
+    case HitType::TabPinned:
+      return k_tabPinned;
+    case HitType::TabAll:
+      return k_tabAll;
+    case HitType::PagePrev:
+      return k_pagePrev;
+    case HitType::PageNext:
+      return k_pageNext;
+    case HitType::StartItem:
+      return gridCellRect(h.index);
+    case HitType::StartSettings:
+      return k_startSettings;
+    case HitType::StartPower:
+      return k_startPower;
+    case HitType::QuickButton:
+      return quickButtonRect(h.index);
+    case HitType::ContextItem:
+      return contextItemRect(h.index);
+    case HitType::WindowMinimize:
+    case HitType::WindowClose:
+      return titleButtonRect(h.index, h.type == HitType::WindowClose);
+    default:
+      return {0, 0, 0, 0};
+  }
+}
+
+bool isHovered(HitType type, int index = 0) {
+  Hit h = hitTest(s.cursorX, s.cursorY);
+  return h.type == type && h.index == index;
+}
+
+/* -------------------------------------------------------------- settings */
+
+void setAlphaLock(bool on) {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  using Status = Ion::Events::ShiftAlphaStatus;
+  if (on) {
+    container->setShiftAlphaStatus(
+        Status(Status::ShiftStatus::Inactive, Status::AlphaStatus::Locked));
+    s.alphaLockedByUs = true;
+  } else if (s.alphaLockedByUs) {
+    container->setShiftAlphaStatus(Status());
+    s.alphaLockedByUs = false;
+  }
+}
+
+void setBrightness(int level) {
+  GlobalPreferences::SharedGlobalPreferences()->setBrightnessLevel(level);
+}
+
+int brightness() {
+  return GlobalPreferences::SharedGlobalPreferences()->brightnessLevel();
+}
+
+/* ------------------------------------------------------------------ menus */
+
+void closeMenu() {
+  if (s.menu == Menu::None) {
+    return;
+  }
+  if (s.menu == Menu::Start) {
+    invalidate(k_startMenu.inset(-4));
+    invalidate(k_startButton);
+    s.searchActive = false;
+    s.searchLength = 0;
+    s.search[0] = 0;
+    setAlphaLock(false);
+  } else if (s.menu == Menu::QuickSettings) {
+    invalidate(k_quickSettings.inset(-4));
+    invalidate(k_trayButton);
+  } else {
+    invalidate(contextRect().inset(-4));
+  }
+  s.menu = Menu::None;
+}
+
+void openStart(bool search) {
+  closeMenu();
+  if (s.keyboardFocus) {
+    s.keyboardFocus = false;
+    if (s.numberOfWindows > 0) {
+      invalidate(windowRect(s.numberOfWindows - 1));
+    }
+  }
+  s.menu = Menu::Start;
+  s.startTab = 0;
+  s.startPage = 0;
+  s.searchLength = 0;
+  s.search[0] = 0;
+  s.searchActive = search;
+  if (search) {
+    setAlphaLock(true);
+  }
+  invalidate(k_startMenu.inset(-4));
+  invalidate(k_startButton);
+}
+
+void openQuickSettings() {
+  closeMenu();
+  s.menu = Menu::QuickSettings;
+  invalidate(k_quickSettings.inset(-4));
+  invalidate(k_trayButton);
+}
+
+void openContext(Item target, int windowIndex, const ContextAction* actions,
+                 int n) {
+  closeMenu();
+  s.menu = Menu::Context;
+  s.contextX = s.cursorX;
+  s.contextY = s.cursorY;
+  s.contextTarget = target;
+  s.contextWindow = windowIndex;
+  s.numberOfContextItems = n > k_maxContextItems ? k_maxContextItems : n;
+  for (int i = 0; i < s.numberOfContextItems; i++) {
+    s.contextActions[i] = actions[i];
+  }
+  invalidate(contextRect().inset(-4));
+}
+
+void openItem(Item item) {
+  if (item.kind == Item::Kind::Window) {
+    openWindow(static_cast<WindowApp>(item.index));
+  } else if (!item.isNone()) {
+    requestLaunch(item);
+  }
+}
+
+void nextWallpaper() {
+  s.theme = (s.theme + 1) % k_numberOfWallpapers;
+  prepareWallpaper(s.theme);
+  invalidateAll();
+}
+
+void sleep() {
+  closeMenu();
+  Ion::Power::suspend(true);
+  AppsContainer::sharedAppsContainer()->didSuspend();
+  invalidateAll();
+}
+
+void quickButton(int i) {
+  switch (i) {
+    case 0:  // Night
+      s.night = !s.night;
+      invalidateAll();
+      break;
+    case 1:  // Saver
+      s.saver = !s.saver;
+      if (s.saver) {
+        s.savedBrightness = brightness();
+        setBrightness(Ion::Backlight::MaxBrightness / 8);
+      } else {
+        setBrightness(s.savedBrightness);
+      }
+      invalidate(k_quickSettings);
+      break;
+    case 2:  // Normal
+      if (s.saver) {
+        setBrightness(s.savedBrightness);
+      }
+      s.saver = false;
+      s.night = false;
+      invalidateAll();
+      break;
+    case 3:  // Theme
+      nextWallpaper();
+      break;
+    case 4:  // Settings
+      closeMenu();
+      requestLaunch(builtinNamed(I18n::Message::SettingsApp));
+      break;
+    case 5:  // Sleep
+      sleep();
+      break;
+  }
+}
+
+void contextAction(ContextAction action) {
+  Item target = s.contextTarget;
+  int w = s.contextWindow;
+  closeMenu();
+  switch (action) {
+    case ContextAction::Open:
+      openItem(target);
+      break;
+    case ContextAction::PinTaskbar:
+      pinToTaskbar(target);
+      invalidate(k_taskbar);
+      break;
+    case ContextAction::UnpinTaskbar:
+      unpinFromTaskbar(target);
+      invalidate(k_taskbar);
+      break;
+    case ContextAction::Minimize:
+      if (w >= 0 && w < s.numberOfWindows) {
+        invalidate(windowRect(w).inset(-4));
+        s.windows[w].minimized = true;
+        s.keyboardFocus = false;
+        invalidate(k_taskbar);
+      }
+      break;
+    case ContextAction::Close:
+      if (w >= 0 && w < s.numberOfWindows) {
+        closeWindow(w);
+      }
+      break;
+    case ContextAction::TaskManager:
+      openWindow(WindowApp::TaskManager);
+      break;
+    case ContextAction::Wallpaper:
+      nextWallpaper();
+      break;
+    case ContextAction::Refresh:
+      buildItems();
+      invalidateAll();
+      break;
+  }
+}
+
+/* ----------------------------------------------------------------- clicks */
+
+void click(bool right) {
+  Hit h = hitTest(s.cursorX, s.cursorY);
+  // A click outside of the open menu closes it
+  bool inMenu = h.type == HitType::ContextPanel ||
+                h.type == HitType::ContextItem ||
+                h.type == HitType::QuickPanel ||
+                h.type == HitType::QuickButton ||
+                h.type == HitType::QuickSlider ||
+                h.type == HitType::StartPanel || h.type == HitType::SearchBox ||
+                h.type == HitType::TabPinned || h.type == HitType::TabAll ||
+                h.type == HitType::PagePrev || h.type == HitType::PageNext ||
+                h.type == HitType::StartItem ||
+                h.type == HitType::StartSettings ||
+                h.type == HitType::StartPower;
+  if (s.menu != Menu::None && !inMenu) {
+    bool toggles = (s.menu == Menu::Start && h.type == HitType::StartButton) ||
+                   (s.menu == Menu::QuickSettings && h.type == HitType::Tray);
+    closeMenu();
+    if (toggles || right) {
+      return;
+    }
+  }
+
+  Item items[k_maxTaskItems];
+  switch (h.type) {
+    case HitType::StartButton:
+      if (!right) {
+        openStart(false);
+      }
+      return;
+    case HitType::SearchButton:
+      if (!right) {
+        openStart(true);
+      }
+      return;
+    case HitType::Tray:
+      if (!right) {
+        openQuickSettings();
+      }
+      return;
+    case HitType::TaskItem: {
+      taskItems(items);
+      Item it = items[h.index];
+      int w = it.kind == Item::Kind::Window
+                  ? windowIndexOf(static_cast<WindowApp>(it.index))
+                  : -1;
+      if (right) {
+        ContextAction actions[3];
+        int n = 0;
+        actions[n++] = ContextAction::Open;
+        actions[n++] = isPinnedToTaskbar(it) ? ContextAction::UnpinTaskbar
+                                             : ContextAction::PinTaskbar;
+        if (w >= 0) {
+          actions[n++] = ContextAction::Close;
+        }
+        openContext(it, w, actions, n);
+        return;
+      }
+      if (w >= 0 && w == s.numberOfWindows - 1 && !s.windows[w].minimized) {
+        // Like Windows: clicking the active window's button minimizes it
+        invalidate(windowRect(w).inset(-4));
+        s.windows[w].minimized = true;
+        s.keyboardFocus = false;
+        invalidate(k_taskbar);
+      } else {
+        openItem(it);
+      }
+      return;
+    }
+    case HitType::SearchBox:
+      if (!s.searchActive) {
+        s.searchActive = true;
+        setAlphaLock(true);
+        invalidate(k_searchBox.inset(-2));
+      }
+      return;
+    case HitType::TabPinned:
+    case HitType::TabAll:
+      s.startTab = h.type == HitType::TabAll ? 1 : 0;
+      s.startPage = 0;
+      invalidate(k_startMenu);
+      return;
+    case HitType::PagePrev:
+    case HitType::PageNext: {
+      int pages = startPageCount();
+      s.startPage = (s.startPage + (h.type == HitType::PageNext ? 1 : pages - 1)) %
+                    pages;
+      invalidate(k_startMenu);
+      return;
+    }
+    case HitType::StartItem: {
+      Item it = startItemAt(s.startPage * k_gridPage + h.index);
+      if (right) {
+        ContextAction actions[2] = {ContextAction::Open,
+                                    isPinnedToTaskbar(it)
+                                        ? ContextAction::UnpinTaskbar
+                                        : ContextAction::PinTaskbar};
+        openContext(it, -1, actions, 2);
+        return;
+      }
+      closeMenu();
+      openItem(it);
+      return;
+    }
+    case HitType::StartSettings:
+      closeMenu();
+      requestLaunch(builtinNamed(I18n::Message::SettingsApp));
+      return;
+    case HitType::StartPower:
+      sleep();
+      return;
+    case HitType::QuickButton:
+      quickButton(h.index);
+      return;
+    case HitType::QuickSlider:
+      if (h.index == 0) {
+        int level = h.value * Ion::Backlight::MaxBrightness / 1000;
+        if (level < 8) {
+          level = 8;
+        }
+        setBrightness(level);
+        s.saver = false;
+      } else {
+        s.cursorSpeed = k_minCursorSpeed +
+                        (h.value * (k_maxCursorSpeed - k_minCursorSpeed) + 500) /
+                            1000;
+      }
+      invalidate(k_quickSettings);
+      return;
+    case HitType::ContextItem:
+      contextAction(s.contextActions[h.index]);
+      return;
+    case HitType::WindowClose:
+      if (right) {
+        break;
+      }
+      closeWindow(h.index);
+      return;
+    case HitType::WindowMinimize:
+      if (right) {
+        break;
+      }
+      invalidate(windowRect(h.index).inset(-4));
+      s.windows[h.index].minimized = true;
+      s.keyboardFocus = false;
+      invalidate(k_taskbar);
+      return;
+    case HitType::WindowTitle:
+      focusWindow(h.index);
+      if (right) {
+        ContextAction actions[2] = {ContextAction::Minimize,
+                                    ContextAction::Close};
+        openContext(windowItem(s.windows[s.numberOfWindows - 1].app),
+                    s.numberOfWindows - 1, actions, 2);
+        return;
+      }
+      // Grab the window: it follows the pointer until the next click
+      s.dragging = true;
+      s.dragDX = s.cursorX - s.windows[s.numberOfWindows - 1].x;
+      s.dragDY = s.cursorY - s.windows[s.numberOfWindows - 1].y;
+      invalidate(windowRect(s.numberOfWindows - 1));
+      return;
+    case HitType::WindowClient: {
+      bool wasTop = h.index == s.numberOfWindows - 1;
+      focusWindow(h.index);
+      int top = s.numberOfWindows - 1;
+      Window& w = s.windows[top];
+      Rect c = clientRect(top);
+      if (!wasTop && !right) {
+        // First click only brings the window to the front
+        if (Apps::wantsKeyboardOnClick(w.app)) {
+          s.keyboardFocus = true;
+          if (w.app == WindowApp::Terminal) {
+            setAlphaLock(true);
+          }
+        }
+        return;
+      }
+      Apps::click(w.app, s.cursorX - c.x, s.cursorY - c.y, right, c);
+      if (!right && Apps::wantsKeyboardOnClick(w.app) && !s.keyboardFocus) {
+        s.keyboardFocus = true;
+        if (w.app == WindowApp::Terminal) {
+          setAlphaLock(true);
+        }
+        invalidate(windowRect(top));
+      }
+      return;
+    }
+    case HitType::Desktop:
+      if (right) {
+        ContextAction actions[3] = {ContextAction::TaskManager,
+                                    ContextAction::Wallpaper,
+                                    ContextAction::Refresh};
+        openContext(k_noItem, -1, actions, 3);
+      }
+      return;
+    default:
+      return;
+  }
+}
+
+/* ----------------------------------------------------------------- moves */
+
+void updateHover() {
+  Hit h = hitTest(s.cursorX, s.cursorY);
+  uint32_t key = h.key();
+  if (key == s.hoverKey) {
+    return;
+  }
+  // Redraw the element that lost the hover and the one that got it
+  Hit old = {static_cast<HitType>(s.hoverKey >> 16),
+             static_cast<int8_t>((s.hoverKey >> 8) & 0xFF), 0};
+  invalidate(hoverRect(old));
+  invalidate(hoverRect(h));
+  s.hoverKey = key;
+}
+
+Rect pointerRect(int x, int y) {
+  return {x, y, WinIcons::k_cursorWidth, WinIcons::k_cursorHeight};
+}
+
+void clampWindowPosition(Window& w) {
+  int width = Apps::clientWidth(w.app) + 2;
+  if (w.x < 40 - width) {
+    w.x = 40 - width;
+  }
+  if (w.x > k_screenWidth - 40) {
+    w.x = k_screenWidth - 40;
+  }
+  if (w.y < 0) {
+    w.y = 0;
+  }
+  if (w.y > k_taskbarY - k_titleHeight) {
+    w.y = k_taskbarY - k_titleHeight;
+  }
+}
+
+void moveCursor(int dx, int dy) {
+  int step = 1 + s.cursorSpeed;
+  int repeat = Ion::Events::longPressCounter();
+  step += repeat > 12 ? 2 * step : (repeat > 4 ? step : 0);
+  int x = s.cursorX + dx * step;
+  int y = s.cursorY + dy * step;
+  x = x < 0 ? 0 : (x > k_screenWidth - 2 ? k_screenWidth - 2 : x);
+  y = y < 0 ? 0 : (y > k_screenHeight - 2 ? k_screenHeight - 2 : y);
+  if (x == s.cursorX && y == s.cursorY) {
+    return;
+  }
+  invalidate(pointerRect(s.cursorX, s.cursorY));
+  s.cursorX = x;
+  s.cursorY = y;
+  invalidate(pointerRect(x, y));
+  if (s.dragging && s.numberOfWindows > 0) {
+    Window& w = s.windows[s.numberOfWindows - 1];
+    Rect before = windowRect(s.numberOfWindows - 1).inset(-4);
+    w.x = x - s.dragDX;
+    w.y = y - s.dragDY;
+    clampWindowPosition(w);
+    invalidate(before);
+    invalidate(windowRect(s.numberOfWindows - 1).inset(-4));
+  }
+  updateHover();
+}
+
+/* -------------------------------------------------------------- drawing */
+
+void drawWindow(Band& b, int i) {
+  const Palette& p = palette();
+  Rect r = windowRect(i);
+  if (!r.inset(-5).intersects(b.area())) {
+    return;
+  }
+  bool top = i == s.numberOfWindows - 1;
+  Window& w = s.windows[i];
+  shadow(b, r, 7, top ? 110 : 60);
+  roundFill(b, r, 7, p.windowBack);
+  // Title bar (rounded at the top only)
+  if (b.setClip({r.x, r.y, r.w, k_titleHeight})) {
+    roundFill(b, {r.x, r.y, r.w, k_titleHeight + 8}, 7,
+              top ? p.title : p.titleInactive);
+    tile(b, Apps::icon(w.app), 14, r.x + 6, r.y + 3);
+    KDColor titleColor = top ? p.text : p.textDim;
+    text(b, Apps::title(w.app), r.x + 26, r.y + 3, titleColor, Small,
+         Align::Left, r.w - 26 - 52);
+    if (top && s.keyboardFocus &&
+        textWidth(Apps::title(w.app)) + textWidth("Back: mouse") + 12 <=
+            r.w - 26 - 52) {
+      text(b, "Back: mouse", r.right() - 52, r.y + 3, p.textDim, Small,
+           Align::Right, 90);
+    }
+    Rect minButton = titleButtonRect(i, false);
+    Rect closeButton = titleButtonRect(i, true);
+    if (isHovered(HitType::WindowMinimize, i)) {
+      fill(b, minButton, KDWhite, 30);
+    }
+    if (isHovered(HitType::WindowClose, i)) {
+      roundFill(b, {closeButton.x, closeButton.y, closeButton.w + 8,
+                    closeButton.h},
+                7, KDColor::RGB24(0xC42B1C));
+    }
+    mask(b, WinIcons::k_maskMinimize, minButton.x + 6, minButton.y + 4,
+         titleColor);
+    mask(b, WinIcons::k_maskClose, closeButton.x + 6, closeButton.y + 4,
+         titleColor);
+    b.resetClip();
+  }
+  roundFrame(b, r, 7, top ? p.border : p.panelBorder);
+  Rect c = clientRect(i);
+  if (b.setClip(c)) {
+    Apps::draw(w.app, b, c, top && s.keyboardFocus);
+    b.resetClip();
+  }
+  if (top && s.dragging) {
+    roundFrame(b, r.inset(-1), 8, p.accent);
+  }
+}
+
+void drawBattery(Band& b, int x, int y, KDColor color) {
+  frame(b, {x, y, 18, 10}, color);
+  fill(b, {x + 18, y + 3, 2, 4}, color);
+  int pct = batteryPercent();
+  int w = 14 * pct / 100;
+  KDColor fillColor = pct <= 15 ? KDColor::RGB24(0xE81123) : color;
+  if (Ion::Battery::isCharging()) {
+    fillColor = KDColor::RGB24(0x6CCB5F);
+  }
+  fill(b, {x + 2, y + 2, w, 6}, fillColor);
+}
+
+void drawTaskbar(Band& b) {
+  if (!k_taskbar.intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  fill(b, k_taskbar, p.taskbar, 236);
+  fill(b, {0, k_taskbarY, k_screenWidth, 1}, p.panelBorder, 160);
+  // Start
+  if (s.menu == Menu::Start || isHovered(HitType::StartButton)) {
+    roundFill(b, k_startButton, 4, KDWhite,
+              s.menu == Menu::Start ? 40 : 26);
+  }
+  mask(b, WinIcons::k_maskWinLogo, k_startButton.x + 4, k_startButton.y + 3,
+       p.accent);
+  if (s.menu == Menu::Start) {
+    fill(b, {k_startButton.x + 9, 236, 8, 2}, p.accent);
+  }
+  // Search
+  if (isHovered(HitType::SearchButton)) {
+    roundFill(b, k_searchButton, 4, KDWhite, 26);
+  }
+  mask(b, WinIcons::k_maskSearch, k_searchButton.x + 5, k_searchButton.y + 4,
+       p.text);
+  // Apps
+  Item items[k_maxTaskItems];
+  int n = taskItems(items);
+  for (int i = 0; i < n; i++) {
+    Rect r = taskItemRect(i);
+    int w = items[i].kind == Item::Kind::Window
+                ? windowIndexOf(static_cast<WindowApp>(items[i].index))
+                : -1;
+    bool active = w >= 0 && w == s.numberOfWindows - 1 &&
+                  !s.windows[w].minimized;
+    if (active || isHovered(HitType::TaskItem, i)) {
+      roundFill(b, r, 4, KDWhite, active ? 34 : 24);
+    }
+    drawItemIcon(b, items[i], 20, r.x + 2, r.y + 2);
+    if (w >= 0) {
+      if (active) {
+        fill(b, {r.x + 7, 236, 10, 2}, p.accent);
+      } else {
+        fill(b, {r.x + 9, 236, 6, 2}, p.textDim);
+      }
+    }
+  }
+  // Clock and battery
+  if (s.menu == Menu::QuickSettings || isHovered(HitType::Tray)) {
+    roundFill(b, k_trayButton, 4, KDWhite,
+              s.menu == Menu::QuickSettings ? 34 : 24);
+  }
+  char clock[8];
+  clockText(clock);
+  text(b, clock, 238, 219, p.text, Small, Align::Center);
+  char pct[8];
+  int pc = batteryPercent();
+  int len = 0;
+  if (pc >= 100) {
+    pct[len++] = '1';
+    pct[len++] = '0';
+    pct[len++] = '0';
+  } else {
+    if (pc >= 10) {
+      pct[len++] = '0' + pc / 10;
+    }
+    pct[len++] = '0' + pc % 10;
+  }
+  pct[len++] = '%';
+  pct[len] = 0;
+  text(b, pct, 293, 219, p.text, Small, Align::Right);
+  drawBattery(b, 296, 222, p.text);
+}
+
+void drawStartMenu(Band& b) {
+  if (!k_startMenu.inset(-5).intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  shadow(b, k_startMenu, 8, 120);
+  roundFill(b, k_startMenu, 8, p.panel, 246);
+  // Search box
+  roundFill(b, k_searchBox, 9, s.searchActive ? p.panelLight : p.button);
+  mask(b, WinIcons::k_maskSearch, k_searchBox.x + 6, k_searchBox.y + 1,
+       p.textDim);
+  if (s.searchLength > 0) {
+    text(b, s.search, k_searchBox.x + 26, k_searchBox.y + 2, p.text);
+  } else {
+    text(b, "Type here to search", k_searchBox.x + 26, k_searchBox.y + 2,
+         p.textDim);
+  }
+  if (s.searchActive) {
+    fill(b, {k_searchBox.x + 8, k_searchBox.bottom() - 1, k_searchBox.w - 16, 2},
+         p.accent);
+    // Text cursor
+    int cx = k_searchBox.x + 26 + s.searchLength * glyphWidth();
+    fill(b, {cx, k_searchBox.y + 3, 1, 12}, p.text);
+  }
+  // Tabs (or search title)
+  if (s.searchLength > 0) {
+    text(b, "Best match", k_tabPinned.x + 4, k_tabPinned.y + 2, p.text);
+  } else {
+    KDColor c0 = s.startTab == 0 ? p.text : p.textDim;
+    KDColor c1 = s.startTab == 1 ? p.text : p.textDim;
+    if (isHovered(HitType::TabPinned)) {
+      roundFill(b, k_tabPinned, 4, KDWhite, 20);
+    }
+    if (isHovered(HitType::TabAll)) {
+      roundFill(b, k_tabAll, 4, KDWhite, 20);
+    }
+    text(b, "Pinned", k_tabPinned.x + 4, k_tabPinned.y + 2, c0);
+    text(b, "All apps", k_tabAll.x + 4, k_tabAll.y + 2, c1);
+    Rect tab = s.startTab == 0 ? k_tabPinned : k_tabAll;
+    fill(b, {tab.x + 4, tab.bottom() - 2, tab.w - 8, 2}, p.accent);
+  }
+  int pages = startPageCount();
+  if (pages > 1) {
+    char page[8] = {static_cast<char>('1' + s.startPage), '/',
+                    static_cast<char>('0' + (pages > 9 ? 9 : pages)), 0};
+    if (isHovered(HitType::PagePrev)) {
+      roundFill(b, k_pagePrev, 4, KDWhite, 24);
+    }
+    if (isHovered(HitType::PageNext)) {
+      roundFill(b, k_pageNext, 4, KDWhite, 24);
+    }
+    text(b, "<", k_pagePrev.x + 7, k_pagePrev.y + 3, p.text);
+    text(b, page, 251, k_pagePrev.y + 3, p.textDim, Small, Align::Center);
+    text(b, ">", k_pageNext.x + 7, k_pageNext.y + 3, p.text);
+  }
+  // Grid
+  int count = startItemCount();
+  if (count == 0) {
+    text(b, "No results", k_startMenu.x + k_startMenu.w / 2, 120, p.textDim,
+         Small, Align::Center);
+  }
+  for (int i = 0; i < k_gridPage; i++) {
+    int index = s.startPage * k_gridPage + i;
+    if (index >= count) {
+      break;
+    }
+    Rect cell = gridCellRect(i);
+    if (!cell.intersects(b.area())) {
+      continue;
+    }
+    if (isHovered(HitType::StartItem, i)) {
+      roundFill(b, cell.inset(1), 5, KDWhite, 26);
+    }
+    Item it = startItemAt(index);
+    drawItemIcon(b, it, 24, cell.x + (cell.w - 24) / 2, cell.y + 3);
+    text(b, itemLabel(it), cell.x + cell.w / 2, cell.y + 28, p.text, Small,
+         Align::Center, cell.w);
+  }
+  // Bottom bar: user, settings, power
+  if (b.setClip(k_startBottom)) {
+    roundFill(b, {k_startBottom.x, k_startBottom.y - 8, k_startBottom.w,
+                  k_startBottom.h + 8},
+              8, p.taskbar, 200);
+    fill(b, {k_startBottom.x, k_startBottom.y, k_startBottom.w, 1},
+         p.panelBorder);
+    mask(b, WinIcons::k_maskUser, 46, k_startBottom.y + 5, p.accent);
+    text(b, "NumWorks", 68, k_startBottom.y + 6, p.text);
+    if (isHovered(HitType::StartSettings)) {
+      roundFill(b, k_startSettings, 4, KDWhite, 26);
+    }
+    if (isHovered(HitType::StartPower)) {
+      roundFill(b, k_startPower, 4, KDWhite, 26);
+    }
+    mask(b, WinIcons::k_maskGearSmall, k_startSettings.x + 4,
+         k_startSettings.y + 4, p.text);
+    mask(b, WinIcons::k_maskPowerSmall, k_startPower.x + 4,
+         k_startPower.y + 4, p.text);
+    b.resetClip();
+  }
+  roundFrame(b, k_startMenu, 8, p.panelBorder);
+}
+
+void drawSlider(Band& b, int i, const WinIcons::Mask& icon, int value1000) {
+  const Palette& p = palette();
+  int y = k_qsSliderY + i * k_qsSliderStep;
+  mask(b, icon, k_qsButtonX, y - 8, p.text);
+  int knob = k_qsSliderX + value1000 * k_qsSliderWidth / 1000;
+  roundFill(b, {k_qsSliderX, y - 2, k_qsSliderWidth, 4}, 2, p.button);
+  roundFill(b, {k_qsSliderX, y - 2, knob - k_qsSliderX, 4}, 2, p.accent);
+  roundFill(b, {knob - 6, y - 6, 12, 12}, 6, p.text);
+  roundFill(b, {knob - 3, y - 3, 6, 6}, 3, p.accent);
+}
+
+void drawQuickSettings(Band& b) {
+  if (!k_quickSettings.inset(-5).intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  shadow(b, k_quickSettings, 8, 120);
+  roundFill(b, k_quickSettings, 8, p.panel, 248);
+  struct Button {
+    const char* label;
+    const WinIcons::Mask* icon;
+    bool active;
+  };
+  Button buttons[6] = {
+      {"Night", &WinIcons::k_maskMoon, s.night},
+      {"Saver", &WinIcons::k_maskSaver, s.saver},
+      {"Normal", &WinIcons::k_maskPlay, !s.night && !s.saver},
+      {"Theme", &WinIcons::k_maskPicture, false},
+      {"Settings", &WinIcons::k_maskGear, false},
+      {"Sleep", &WinIcons::k_maskPower, false},
+  };
+  for (int i = 0; i < 6; i++) {
+    Rect r = quickButtonRect(i);
+    if (!r.intersects(b.area())) {
+      continue;
+    }
+    bool hover = isHovered(HitType::QuickButton, i);
+    KDColor back = buttons[i].active ? p.accent
+                                     : (hover ? p.buttonHover : p.button);
+    KDColor fore = buttons[i].active ? p.onAccent : p.text;
+    roundFill(b, r, 6, back);
+    int size = buttons[i].icon->size;
+    mask(b, *buttons[i].icon, r.x + (r.w - size) / 2, r.y + 5, fore);
+    text(b, buttons[i].label, r.x + r.w / 2, r.y + 23, fore, Small,
+         Align::Center, r.w);
+  }
+  drawSlider(b, 0, WinIcons::k_maskSun,
+             brightness() * 1000 / Ion::Backlight::MaxBrightness);
+  drawSlider(b, 1, WinIcons::k_maskCursorSpeed,
+             (s.cursorSpeed - k_minCursorSpeed) * 1000 /
+                 (k_maxCursorSpeed - k_minCursorSpeed));
+  char footer[24];
+  int pc = batteryPercent();
+  int n = 0;
+  if (pc >= 100) {
+    footer[n++] = '1';
+    footer[n++] = '0';
+  } else if (pc >= 10) {
+    footer[n++] = '0' + pc / 10;
+  }
+  footer[n++] = '0' + pc % 10;
+  footer[n++] = '%';
+  footer[n] = 0;
+  int y = k_quickSettings.bottom() - 20;
+  fill(b, {k_quickSettings.x + 1, y - 4, k_quickSettings.w - 2, 1},
+       p.panelBorder);
+  text(b, footer, k_qsButtonX, y, p.text);
+  const char* power = Ion::Battery::isCharging()
+                          ? "Charging"
+                          : (Ion::USB::isPlugged() ? "Plugged in" : "On battery");
+  text(b, power, k_qsButtonX + 40, y, p.textDim);
+  roundFrame(b, k_quickSettings, 8, p.panelBorder);
+}
+
+const char* contextLabel(ContextAction a) {
+  switch (a) {
+    case ContextAction::Open:
+      return "Open";
+    case ContextAction::PinTaskbar:
+      return "Pin to taskbar";
+    case ContextAction::UnpinTaskbar:
+      return "Unpin from taskbar";
+    case ContextAction::Minimize:
+      return "Minimize";
+    case ContextAction::Close:
+      return "Close window";
+    case ContextAction::TaskManager:
+      return "Task manager";
+    case ContextAction::Wallpaper:
+      return "Next wallpaper";
+    case ContextAction::Refresh:
+      return "Refresh";
+  }
+  return "";
+}
+
+const WinIcons::Mask& contextIcon(ContextAction a) {
+  switch (a) {
+    case ContextAction::Open:
+      return WinIcons::k_maskArrow;
+    case ContextAction::PinTaskbar:
+    case ContextAction::UnpinTaskbar:
+      return WinIcons::k_maskUnpin;
+    case ContextAction::Minimize:
+      return WinIcons::k_maskMinimize;
+    case ContextAction::Close:
+      return WinIcons::k_maskClose;
+    case ContextAction::TaskManager:
+      return WinIcons::k_maskWinLogoSmall;
+    case ContextAction::Wallpaper:
+      return WinIcons::k_maskPicture;
+    case ContextAction::Refresh:
+      return WinIcons::k_maskRefresh;
+  }
+  return WinIcons::k_maskArrow;
+}
+
+void drawContextMenu(Band& b) {
+  Rect r = contextRect();
+  if (!r.inset(-5).intersects(b.area())) {
+    return;
+  }
+  const Palette& p = palette();
+  shadow(b, r, 6, 110);
+  roundFill(b, r, 6, p.panel, 248);
+  for (int i = 0; i < s.numberOfContextItems; i++) {
+    Rect item = contextItemRect(i);
+    if (isHovered(HitType::ContextItem, i)) {
+      roundFill(b, item, 4, KDWhite, 26);
+    }
+    ContextAction a = s.contextActions[i];
+    const WinIcons::Mask& icon = contextIcon(a);
+    mask(b, icon, item.x + 6, item.y + (item.h - icon.size) / 2, p.text);
+    if (a == ContextAction::UnpinTaskbar) {
+      // Strike the pin in red, like the reference
+      for (int k = 0; k < 12; k++) {
+        fill(b, {item.x + 6 + 11 - k, item.y + 5 + k, 1, 1},
+             KDColor::RGB24(0xE81123));
+      }
+    }
+    text(b, contextLabel(a), item.x + 24, item.y + 4, p.text, Small,
+         Align::Left, item.w - 28);
+  }
+  roundFrame(b, r, 6, p.panelBorder);
+}
+
+}  // namespace
+
+/* =============================================================== helpers */
+
+const Palette& palette() { return s.night ? k_night : k_normal; }
+
+void invalidate(Rect r) {
+  Rect z = r.intersection(k_screen);
+  if (!z.isEmpty() && s_invalidator) {
+    s_invalidator(z);
+  }
+}
+
+void invalidateAll() { invalidate(k_screen); }
+
+Rect windowRect(int i) {
+  const Window& w = s.windows[i];
+  return {w.x, w.y, Apps::clientWidth(w.app) + 2,
+          Apps::clientHeight(w.app) + k_titleHeight + 1};
+}
+
+Rect clientRect(int i) {
+  Rect r = windowRect(i);
+  return {r.x + 1, r.y + k_titleHeight, r.w - 2, r.h - k_titleHeight - 1};
+}
+
+int windowIndexOf(WindowApp app) {
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    if (s.windows[i].app == app) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+void focusWindow(int i) {
+  if (i < 0 || i >= s.numberOfWindows) {
+    return;
+  }
+  int top = s.numberOfWindows - 1;
+  bool changed = i != top || s.windows[i].minimized;
+  if (i != top) {
+    s.keyboardFocus = false;
+    invalidate(windowRect(top).inset(-4));
+    Window w = s.windows[i];
+    for (int j = i; j < top; j++) {
+      s.windows[j] = s.windows[j + 1];
+    }
+    s.windows[top] = w;
+  }
+  s.windows[top].minimized = false;
+  if (changed) {
+    invalidate(windowRect(top).inset(-4));
+    invalidate(k_taskbar);
+  }
+}
+
+void openWindow(WindowApp app) {
+  int existing = windowIndexOf(app);
+  if (existing >= 0) {
+    focusWindow(existing);
+  } else {
+    if (s.numberOfWindows >= k_maxWindows) {
+      return;
+    }
+    s.keyboardFocus = false;
+    if (s.numberOfWindows > 0) {
+      invalidate(windowRect(s.numberOfWindows - 1));
+    }
+    Window& w = s.windows[s.numberOfWindows++];
+    w.app = app;
+    w.minimized = false;
+    int offset = 10 * ((s.numberOfWindows - 1) % 4);
+    int width = Apps::clientWidth(app) + 2;
+    int height = Apps::clientHeight(app) + k_titleHeight + 1;
+    w.x = (k_screenWidth - width) / 2 - 12 + offset;
+    w.y = (k_taskbarY - height) / 2 - 8 + offset;
+    if (w.x < 2) {
+      w.x = 2;
+    }
+    if (w.y < 2) {
+      w.y = 2;
+    }
+    Apps::open(app);
+    invalidate(windowRect(s.numberOfWindows - 1).inset(-4));
+    invalidate(k_taskbar);
+  }
+  // Games and the terminal take the keyboard right away
+  if (Apps::wantsKeyboardOnClick(app)) {
+    s.keyboardFocus = true;
+    if (app == WindowApp::Terminal) {
+      setAlphaLock(true);
+    }
+    invalidate(windowRect(s.numberOfWindows - 1));
+  }
+}
+
+void closeWindow(int i) {
+  if (i < 0 || i >= s.numberOfWindows) {
+    return;
+  }
+  invalidate(windowRect(i).inset(-4));
+  if (i == s.numberOfWindows - 1) {
+    s.keyboardFocus = false;
+    s.dragging = false;
+    setAlphaLock(false);
+  }
+  for (int j = i; j + 1 < s.numberOfWindows; j++) {
+    s.windows[j] = s.windows[j + 1];
+  }
+  s.numberOfWindows--;
+  if (s.numberOfWindows > 0) {
+    invalidate(windowRect(s.numberOfWindows - 1));
+  }
+  invalidate(k_taskbar);
+}
+
+void requestLaunch(Item item) {
+  if (itemIsValid(item) && item.kind != Item::Kind::Window) {
+    s_launch = item;
+  }
+}
+
+const char* itemLabel(Item item) {
+  switch (item.kind) {
+    case Item::Kind::Builtin:
+      return I18n::translate(builtinDescriptor(item.index)->name());
+    case Item::Kind::Window:
+      return Apps::title(static_cast<WindowApp>(item.index));
+    case Item::Kind::External: {
+      const char* name =
+          AppsContainer::sharedAppsContainer()->externalAppAtIndex(item.index)
+              .name();
+      return name ? name : "App";
+    }
+    default:
+      return "";
+  }
+}
+
+void drawItemIcon(Band& b, Item item, int size, int x, int y) {
+  switch (item.kind) {
+    case Item::Kind::Builtin:
+      for (int i = 0; i < s_numberOfBuiltin; i++) {
+        if (s_builtin[i] == item.index) {
+          tile(b, s_builtinTile[i], size, x, y);
+          return;
+        }
+      }
+      tile(b, WinIcons::TileCode, size, x, y);
+      return;
+    case Item::Kind::Window:
+      tile(b, Apps::icon(static_cast<WindowApp>(item.index)), size, x, y);
+      return;
+    case Item::Kind::External:
+      gameIcon(b,
+               AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+                   item.index),
+               x, y, size);
+      return;
+    default:
+      return;
+  }
+}
+
+int numberOfAllItems() {
+  return s_numberOfBuiltin + k_numberOfWindowApps + s_numberOfGames;
+}
+
+Item allItemAtIndex(int i) {
+  if (i < s_numberOfBuiltin) {
+    return {Item::Kind::Builtin, s_builtin[i]};
+  }
+  i -= s_numberOfBuiltin;
+  if (i < k_numberOfWindowApps) {
+    return windowItem(static_cast<WindowApp>(i));
+  }
+  i -= k_numberOfWindowApps;
+  return {Item::Kind::External, static_cast<int16_t>(i)};
+}
+
+bool itemByName(const char* name, Item* result) {
+  int total = numberOfAllItems();
+  int len = strlen(name);
+  if (len == 0) {
+    return false;
+  }
+  for (int i = 0; i < total; i++) {
+    Item it = allItemAtIndex(i);
+    const char* label = itemLabel(it);
+    int k = 0;
+    while (k < len && label[k] && lower(label[k]) == lower(name[k])) {
+      k++;
+    }
+    if (k == len) {
+      *result = it;
+      return true;
+    }
+  }
+  return false;
+}
+
+int batteryPercent() {
+  float v = Ion::Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+uint32_t uptimeSeconds() {
+  return static_cast<uint32_t>(Ion::Timing::millis() / 1000);
+}
+
+void clockText(char* buffer) {
+  int minutes = static_cast<int>(uptimeSeconds() / 60) + s.clockOffsetMinutes;
+  minutes %= 24 * 60;
+  if (minutes < 0) {
+    minutes += 24 * 60;
+  }
+  int h = minutes / 60, m = minutes % 60;
+  buffer[0] = '0' + h / 10;
+  buffer[1] = '0' + h % 10;
+  buffer[2] = ':';
+  buffer[3] = '0' + m / 10;
+  buffer[4] = '0' + m % 10;
+  buffer[5] = 0;
+}
+
+/* ================================================================= shell */
+
+namespace Shell {
+
+void setInvalidator(void (*f)(Rect)) { s_invalidator = f; }
+
+void setLastRedrawDuration(int ms) { s.lastRedrawMs = ms; }
+
+void enter() {
+  buildItems();
+  if (!s.initialized) {
+    s.initialized = true;
+    s.cursorX = 150;
+    s.cursorY = 100;
+    s.cursorSpeed = 3;
+    s.theme = 0;
+    s.savedBrightness = brightness();
+    constexpr I18n::Message k_pins[] = {
+        I18n::Message::CalculApp, I18n::Message::FunctionApp,
+        I18n::Message::SolverApp};
+    for (I18n::Message m : k_pins) {
+      Item it = builtinNamed(m);
+      if (!it.isNone()) {
+        pinToTaskbar(it);
+      }
+    }
+    pinToTaskbar(windowItem(WindowApp::Terminal));
+    pinToTaskbar(windowItem(WindowApp::Files));
+    s.g2048.best = 0;
+  }
+  // Forget pins to games that are gone
+  for (int i = 0; i < s.numberOfTaskbarPins;) {
+    if (!itemIsValid(s.taskbarPins[i])) {
+      unpinFromTaskbar(s.taskbarPins[i]);
+    } else {
+      i++;
+    }
+  }
+  prepareWallpaper(s.theme);
+  s.menu = Menu::None;
+  s.dragging = false;
+  s.searchActive = false;
+  s.searchLength = 0;
+  s.alphaLockedByUs = false;
+  s.hoverKey = hitTest(s.cursorX, s.cursorY).key();
+  if (s.numberOfWindows == 0 || s.windows[s.numberOfWindows - 1].minimized) {
+    s.keyboardFocus = false;
+  }
+  s_launch = k_noItem;
+}
+
+void leave() {
+  setAlphaLock(false);
+  s.dragging = false;
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    // Let the container update the shift / alpha state
+    return false;
+  }
+  int top = s.numberOfWindows - 1;
+  // Keys go to the focused window app
+  if (s.keyboardFocus && top >= 0 && !s.windows[top].minimized &&
+      s.menu == Menu::None) {
+    if (e == Events::Back || e == Events::Home) {
+      s.keyboardFocus = false;
+      setAlphaLock(false);
+      invalidate(windowRect(top));
+      return true;
+    }
+    Apps::handleKey(s.windows[top].app, e, clientRect(top));
+    return true;
+  }
+  s.keyboardFocus = false;
+  // Typing in the start menu search box
+  if (s.menu == Menu::Start && s.searchActive) {
+    if (e == Events::Backspace) {
+      if (s.searchLength > 0) {
+        s.search[--s.searchLength] = 0;
+        s.startPage = 0;
+        invalidate(k_startMenu);
+      }
+      return true;
+    }
+    if (e == Events::EXE) {
+      Item it = startItemAt(0);
+      if (!it.isNone()) {
+        closeMenu();
+        openItem(it);
+      }
+      return true;
+    }
+    const char* t = e.text();
+    if (t != nullptr && t[0] >= ' ' && t[0] < 127 && t[1] == 0 &&
+        s.searchLength < k_maxSearch) {
+      s.search[s.searchLength++] = t[0];
+      s.search[s.searchLength] = 0;
+      s.startPage = 0;
+      invalidate(k_startMenu);
+      return true;
+    }
+  }
+  if (e == Events::Back || e == Events::Home) {
+    if (s.dragging) {
+      s.dragging = false;
+      if (top >= 0) {
+        invalidate(windowRect(top).inset(-2));
+      }
+    } else if (s.menu != Menu::None) {
+      closeMenu();
+    } else {
+      /* On the calculator, Home comes back here as Back (the kernel jumps to
+       * the Home checkpoint): both open the start menu, like the Windows
+       * key. */
+      openStart(false);
+    }
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right || e == Events::Up ||
+      e == Events::Down) {
+    int dx = e == Events::Left ? -1 : (e == Events::Right ? 1 : 0);
+    int dy = e == Events::Up ? -1 : (e == Events::Down ? 1 : 0);
+    moveCursor(dx, dy);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (s.dragging) {
+      s.dragging = false;
+      if (top >= 0) {
+        invalidate(windowRect(top).inset(-2));
+      }
+      return true;
+    }
+    click(false);
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    if (!s.dragging) {
+      click(true);
+    }
+    return true;
+  }
+  if (e == Events::Var) {
+    // The "Windows" key
+    if (s.menu == Menu::Start) {
+      closeMenu();
+    } else {
+      openStart(false);
+    }
+    return true;
+  }
+  // Other keys are swallowed so that they do not leave the desktop
+  return true;
+}
+
+bool tick() {
+  s.ticks++;
+  bool redraw = false;
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    bool focused = i == s.numberOfWindows - 1 && s.keyboardFocus &&
+                   s.menu == Menu::None;
+    if (Apps::tick(s.windows[i].app, focused, clientRect(i))) {
+      redraw = true;
+    }
+  }
+  uint16_t minute = static_cast<uint16_t>(uptimeSeconds() / 60);
+  if (minute != s.lastClockMinute) {
+    s.lastClockMinute = minute;
+    invalidate(k_trayButton);
+    redraw = true;
+  }
+  if (s.ticks % 10 == 0) {
+    int pc = batteryPercent();
+    if (pc != s.lastBatteryPercent) {
+      s.lastBatteryPercent = pc;
+      invalidate(k_trayButton);
+      if (s.menu == Menu::QuickSettings) {
+        invalidate(k_quickSettings);
+      }
+      redraw = true;
+    }
+  }
+  return redraw;
+}
+
+void render(Band& b) {
+  wallpaper(b);
+  for (int i = 0; i < s.numberOfWindows; i++) {
+    if (!s.windows[i].minimized) {
+      drawWindow(b, i);
+    }
+  }
+  drawTaskbar(b);
+  if (s.menu == Menu::Start) {
+    drawStartMenu(b);
+  } else if (s.menu == Menu::QuickSettings) {
+    drawQuickSettings(b);
+  } else if (s.menu == Menu::Context) {
+    drawContextMenu(b);
+  }
+  pointer(b, s.cursorX, s.cursorY);
+}
+
+}  // namespace Shell
+
+}  // namespace Win
+}  // namespace Home
diff --git a/epsilon/apps/home/win/shell.h b/epsilon/apps/home/win/shell.h
new file mode 100644
