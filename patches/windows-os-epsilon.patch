new file mode 100644
index 0000000000..089412464a
--- /dev/null
+++ b/epsilon/apps/home/win/state.h
@@ -0,0 +1,213 @@
+#pragma once
+
+/* Internal state of the Windows-OS shell, shared by the desktop (shell.cpp)
+ * and the window apps (apps.cpp). */
+
+#include <ion/events.h>
+#include <stdint.h>
+
+#include "gfx.h"
+#include "shell.h"
+
+namespace Home {
+namespace Win {
+
+// Apps that run in a window on the desktop
+enum class WindowApp : uint8_t {
+  Terminal = 0,
+  Files,
+  TaskManager,
+  Snake,
+  Game2048,
+  Minesweeper,
+  NumberOfWindowApps
+};
+constexpr int k_numberOfWindowApps =
+    static_cast<int>(WindowApp::NumberOfWindowApps);
+
+/* ------------------------------------------------------------ palette */
+
+struct Palette {
+  KDColor taskbar, panel, panelLight, panelBorder, button, buttonHover;
+  KDColor accent, onAccent, text, textDim;
+  KDColor windowBack, title, titleInactive, border;
+};
+
+const Palette& palette();
+
+/* ------------------------------------------------------------ window apps */
+
+struct Game2048State {
+  uint16_t cells[16];
+  uint32_t score;
+  uint32_t best;
+  bool over;
+  bool won;
+};
+
+struct SnakeState {
+  constexpr static int k_columns = 22;
+  constexpr static int k_rows = 13;
+  constexpr static int k_maxLength = 96;
+  uint8_t x[k_maxLength], y[k_maxLength];  // x[0], y[0]: head
+  uint8_t length;
+  uint8_t direction;  // 0 right, 1 down, 2 left, 3 up
+  uint8_t nextDirection;
+  uint8_t foodX, foodY;
+  uint16_t score, best;
+  bool dead;
+  bool started;
+};
+
+struct MinesState {
+  constexpr static int k_columns = 16;
+  constexpr static int k_rows = 8;
+  constexpr static int k_mines = 20;
+  // bit 7 mine, bit 6 open, bit 5 flag, bits 0..3 neighbours
+  uint8_t cells[k_columns * k_rows];
+  uint8_t selX, selY;
+  bool started, lost, won;
+  uint32_t startTime;
+  uint16_t seconds;
+};
+
+struct TerminalState {
+  constexpr static int k_lines = 9;
+  constexpr static int k_columns = 36;
+  char lines[k_lines][k_columns + 1];
+  char input[k_columns - 4];
+  uint8_t inputLength;
+  char last[k_columns - 4];
+};
+
+struct FilesState {
+  uint8_t section;  // 0 all files, 1 python scripts
+  int8_t selected;
+  uint8_t scroll;
+  bool confirmDelete;
+};
+
+struct TaskManagerState {
+  uint8_t tab;  // 0 processes, 1 performance, 2 launch
+  int8_t selected;
+  uint8_t scroll;
+};
+
+/* ------------------------------------------------------------ desktop */
+
+struct Window {
+  WindowApp app;
+  int16_t x, y;
+  bool minimized;
+};
+
+constexpr int k_maxWindows = k_numberOfWindowApps;
+constexpr int k_titleHeight = 20;
+
+enum class Menu : uint8_t { None, Start, QuickSettings, Context };
+
+constexpr int k_maxContextItems = 4;
+enum class ContextAction : uint8_t {
+  Open,
+  PinTaskbar,
+  UnpinTaskbar,
+  Minimize,
+  Close,
+  TaskManager,
+  Wallpaper,
+  Refresh,
+};
+
+constexpr int k_maxTaskbarPins = 6;
+constexpr int k_maxSearch = 14;
+
+struct State {
+  bool initialized;
+  int16_t cursorX, cursorY;
+  // Windows, from the bottom (0) to the top
+  Window windows[k_maxWindows];
+  uint8_t numberOfWindows;
+  bool keyboardFocus;  // the top window gets the keys
+  bool dragging;
+  int16_t dragDX, dragDY;
+  Menu menu;
+  // Start menu
+  uint8_t startTab;  // 0 pinned, 1 all apps
+  uint8_t startPage;
+  bool searchActive;
+  char search[k_maxSearch + 1];
+  uint8_t searchLength;
+  // Context menu
+  int16_t contextX, contextY;
+  uint8_t numberOfContextItems;
+  ContextAction contextActions[k_maxContextItems];
+  Item contextTarget;
+  int8_t contextWindow;
+  // Hover (to redraw highlights when it changes)
+  uint32_t hoverKey;
+  // Settings
+  uint8_t theme;
+  bool night;
+  bool saver;
+  uint8_t cursorSpeed;  // 1..5
+  int savedBrightness;
+  Item taskbarPins[k_maxTaskbarPins];
+  uint8_t numberOfTaskbarPins;
+  int16_t clockOffsetMinutes;
+  uint16_t lastClockMinute;
+  uint8_t lastBatteryPercent;
+  int lastRedrawMs;
+  uint32_t ticks;
+  bool alphaLockedByUs;
+  // Window apps
+  Game2048State g2048;
+  SnakeState snake;
+  MinesState mines;
+  TerminalState terminal;
+  FilesState files;
+  TaskManagerState taskManager;
+};
+
+extern State s;
+
+/* ------------------------------------------------------------ helpers */
+
+void invalidate(Rect r);
+void invalidateAll();
+Rect windowRect(int windowIndex);
+Rect clientRect(int windowIndex);
+int windowIndexOf(WindowApp app);  // -1 if not open
+void openWindow(WindowApp app);
+void closeWindow(int windowIndex);
+void focusWindow(int windowIndex);
+void requestLaunch(Item item);
+
+// Items
+const char* itemLabel(Item item);
+void drawItemIcon(Band& b, Item item, int size, int x, int y);
+int numberOfAllItems();
+Item allItemAtIndex(int i);
+bool itemByName(const char* name, Item* result);
+int batteryPercent();
+uint32_t uptimeSeconds();
+void clockText(char* buffer);  // "HH:MM"
+
+// Window apps (apps.cpp)
+namespace Apps {
+const char* title(WindowApp app);
+uint8_t icon(WindowApp app);
+int clientWidth(WindowApp app);
+int clientHeight(WindowApp app);
+bool wantsKeyboardOnClick(WindowApp app);
+void open(WindowApp app);
+void draw(WindowApp app, Band& b, Rect client, bool focused);
+// Keys while the window has the keyboard. Returns true if handled.
+bool handleKey(WindowApp app, Ion::Events::Event event, Rect client);
+// Mouse click (or right click) at (x, y) relative to the client area
+void click(WindowApp app, int x, int y, bool right, Rect client);
+// Every tick, for the open window apps. Returns true if it needs a redraw.
+bool tick(WindowApp app, bool focused, Rect client);
+}  // namespace Apps
+
+}  // namespace Win
+}  // namespace Home
