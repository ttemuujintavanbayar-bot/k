+/* =============================================================== Snake */
+
+namespace SnakeGame {
+
+constexpr int k_cell = 8;
+constexpr int k_width = SnakeState::k_columns * k_cell + 8;
+constexpr int k_height = SnakeState::k_rows * k_cell + 26;
+
+void placeFood(SnakeState& g) {
+  for (int tries = 0; tries < 200; tries++) {
+    uint8_t x = random(SnakeState::k_columns);
+    uint8_t y = random(SnakeState::k_rows);
+    bool onSnake = false;
+    for (int i = 0; i < g.length; i++) {
+      onSnake = onSnake || (g.x[i] == x && g.y[i] == y);
+    }
+    if (!onSnake) {
+      g.foodX = x;
+      g.foodY = y;
+      return;
+    }
+  }
+}
+
+void reset(SnakeState& g) {
+  g.length = 4;
+  for (int i = 0; i < g.length; i++) {
+    g.x[i] = 8 - i;
+    g.y[i] = SnakeState::k_rows / 2;
+  }
+  g.direction = g.nextDirection = 0;
+  g.score = 0;
+  g.dead = false;
+  g.started = false;
+  placeFood(g);
+}
+
+Rect boardRect(Rect c) {
+  return {c.x + 4, c.y + 22, SnakeState::k_columns * k_cell,
+          SnakeState::k_rows * k_cell};
+}
+
+Rect cellRect(Rect c, int x, int y) {
+  Rect board = boardRect(c);
+  return {board.x + x * k_cell, board.y + y * k_cell, k_cell, k_cell};
+}
+
+void step(SnakeState& g, Rect c) {
+  // No U-turn
+  if ((g.nextDirection + 2) % 4 != g.direction) {
+    g.direction = g.nextDirection;
+  }
+  int dx = g.direction == 0 ? 1 : (g.direction == 2 ? -1 : 0);
+  int dy = g.direction == 1 ? 1 : (g.direction == 3 ? -1 : 0);
+  int nx = g.x[0] + dx;
+  int ny = g.y[0] + dy;
+  if (nx < 0 || ny < 0 || nx >= SnakeState::k_columns ||
+      ny >= SnakeState::k_rows) {
+    g.dead = true;
+    invalidate(c);
+    return;
+  }
+  for (int i = 0; i < g.length - 1; i++) {
+    if (g.x[i] == nx && g.y[i] == ny) {
+      g.dead = true;
+      invalidate(c);
+      return;
+    }
+  }
+  bool eat = nx == g.foodX && ny == g.foodY;
+  // Tail cell to clear
+  invalidate(cellRect(c, g.x[g.length - 1], g.y[g.length - 1]));
+  if (eat && g.length < SnakeState::k_maxLength) {
+    g.length++;
+  }
+  for (int i = g.length - 1; i > 0; i--) {
+    g.x[i] = g.x[i - 1];
+    g.y[i] = g.y[i - 1];
+  }
+  g.x[0] = nx;
+  g.y[0] = ny;
+  invalidate(cellRect(c, g.x[1], g.y[1]));
+  invalidate(cellRect(c, nx, ny));
+  if (eat) {
+    g.score++;
+    if (g.score > g.best) {
+      g.best = g.score;
+    }
+    placeFood(g);
+    invalidate(cellRect(c, g.foodX, g.foodY));
+    invalidate({c.x, c.y, c.w, 20});
+  }
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  SnakeState& g = s.snake;
+  fill(b, c, p.windowBack);
+  char buffer[32];
+  fmt(buffer, sizeof(buffer), "Score %d", g.score);
+  text(b, buffer, c.x + 6, c.y + 3, p.text);
+  fmt(buffer, sizeof(buffer), "Best %d", g.best);
+  text(b, buffer, c.right() - 6, c.y + 3, p.textDim, Small, Align::Right);
+  Rect board = boardRect(c);
+  fill(b, board, KDColor::RGB24(0x16261A));
+  // Checkerboard, lightly
+  for (int y = 0; y < SnakeState::k_rows; y++) {
+    for (int x = (y & 1); x < SnakeState::k_columns; x += 2) {
+      fill(b, cellRect(c, x, y), KDColor::RGB24(0x1B2E20));
+    }
+  }
+  Rect food = cellRect(c, g.foodX, g.foodY);
+  roundFill(b, food.inset(1), 3, KDColor::RGB24(0xE84A3C));
+  for (int i = g.length - 1; i >= 0; i--) {
+    Rect r = cellRect(c, g.x[i], g.y[i]);
+    KDColor col = i == 0 ? KDColor::RGB24(0x9BE37A) : KDColor::RGB24(0x46C26A);
+    roundFill(b, r, 2, col);
+  }
+  if (g.dead || !g.started || !focused) {
+    const char* msg = g.dead ? "Game over - OK: again"
+                             : (focused ? "Arrows: start" : "OK: play");
+    int w = textWidth(msg) + 16;
+    Rect box = {board.x + (board.w - w) / 2, board.y + board.h / 2 - 11, w,
+                22};
+    roundFill(b, box, 5, KDBlack, 180);
+    text(b, msg, box.x + box.w / 2, box.y + 4, k_white, Small, Align::Center);
+  }
+}
+
+bool handleKey(Event e, Rect c) {
+  SnakeState& g = s.snake;
+  int direction = e == Events::Right  ? 0
+                  : e == Events::Down ? 1
+                  : e == Events::Left ? 2
+                  : e == Events::Up   ? 3
+                                      : -1;
+  if (direction >= 0 && !g.dead) {
+    if (!g.started) {
+      g.started = true;
+      invalidate(c);
+    }
+    if ((direction + 2) % 4 != g.direction) {
+      g.nextDirection = direction;
+      // Turning moves right away: holding a key makes the snake run
+      step(g, c);
+    }
+    return true;
+  }
+  if ((e == Events::OK || e == Events::EXE) && g.dead) {
+    reset(g);
+    invalidate(c);
+    return true;
+  }
+  return false;
+}
+
+bool tick(bool focused, Rect c) {
+  SnakeState& g = s.snake;
+  if (!focused || g.dead || !g.started) {
+    return false;
+  }
+  step(g, c);
+  return true;
+}
+
+}  // namespace SnakeGame
+
+/* ========================================================= Minesweeper */
+
+namespace Mines {
+
+constexpr int k_cell = 16;
+constexpr int k_header = 24;
+constexpr int k_width = MinesState::k_columns * k_cell + 2;
+constexpr int k_height = MinesState::k_rows * k_cell + k_header + 2;
+constexpr uint8_t k_mine = 0x80, k_open = 0x40, k_flag = 0x20;
+
+void reset(MinesState& g) {
+  memset(g.cells, 0, sizeof(g.cells));
+  g.started = g.lost = g.won = false;
+  g.seconds = 0;
+  g.selX = MinesState::k_columns / 2;
+  g.selY = MinesState::k_rows / 2;
+}
+
+int index(int x, int y) { return y * MinesState::k_columns + x; }
+
+void layMines(MinesState& g, int safeX, int safeY) {
+  int placed = 0;
+  while (placed < MinesState::k_mines) {
+    int x = random(MinesState::k_columns);
+    int y = random(MinesState::k_rows);
+    int dx = x - safeX, dy = y - safeY;
+    if ((dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1) ||
+        (g.cells[index(x, y)] & k_mine)) {
+      continue;
+    }
+    g.cells[index(x, y)] |= k_mine;
+    placed++;
+  }
+  for (int y = 0; y < MinesState::k_rows; y++) {
+    for (int x = 0; x < MinesState::k_columns; x++) {
+      int n = 0;
+      for (int j = -1; j <= 1; j++) {
+        for (int i = -1; i <= 1; i++) {
+          int xx = x + i, yy = y + j;
+          if (xx >= 0 && yy >= 0 && xx < MinesState::k_columns &&
+              yy < MinesState::k_rows && (g.cells[index(xx, yy)] & k_mine)) {
+            n++;
+          }
+        }
+      }
+      g.cells[index(x, y)] |= n;
+    }
+  }
+  g.started = true;
+  g.startTime = static_cast<uint32_t>(Ion::Timing::millis() / 1000);
+}
+
+void open(MinesState& g, int x, int y) {
+  // Flood fill without recursion: a small explicit stack
+  constexpr int k_stack = MinesState::k_columns * MinesState::k_rows;
+  uint8_t stack[k_stack];
+  int n = 0;
+  stack[n++] = index(x, y);
+  while (n > 0) {
+    int i = stack[--n];
+    uint8_t& c = g.cells[i];
+    if (c & (k_open | k_flag)) {
+      continue;
+    }
+    c |= k_open;
+    if (c & k_mine) {
+      g.lost = true;
+      continue;
+    }
+    if ((c & 0x0F) == 0) {
+      int cx = i % MinesState::k_columns, cy = i / MinesState::k_columns;
+      for (int j = -1; j <= 1; j++) {
+        for (int k = -1; k <= 1; k++) {
+          int xx = cx + k, yy = cy + j;
+          if (xx >= 0 && yy >= 0 && xx < MinesState::k_columns &&
+              yy < MinesState::k_rows && n < k_stack &&
+              !(g.cells[index(xx, yy)] & k_open)) {
+            stack[n++] = index(xx, yy);
+          }
+        }
+      }
+    }
+  }
+  if (g.lost) {
+    for (int i = 0; i < MinesState::k_columns * MinesState::k_rows; i++) {
+      if (g.cells[i] & k_mine) {
+        g.cells[i] |= k_open;
+      }
+    }
+    return;
+  }
+  int closedSafe = 0;
+  for (int i = 0; i < MinesState::k_columns * MinesState::k_rows; i++) {
+    if (!(g.cells[i] & k_open) && !(g.cells[i] & k_mine)) {
+      closedSafe++;
+    }
+  }
+  g.won = closedSafe == 0;
+}
+
+void reveal(MinesState& g, int x, int y) {
+  if (g.lost || g.won) {
+    return;
+  }
+  if (!g.started) {
+    layMines(g, x, y);
+  }
+  open(g, x, y);
+}
+
+void toggleFlag(MinesState& g, int x, int y) {
+  if (g.lost || g.won) {
+    return;
+  }
+  uint8_t& c = g.cells[index(x, y)];
+  if (!(c & k_open)) {
+    c ^= k_flag;
+  }
+}
+
+int flags(const MinesState& g) {
+  int n = 0;
+  for (int i = 0; i < MinesState::k_columns * MinesState::k_rows; i++) {
+    n += (g.cells[i] & k_flag) ? 1 : 0;
+  }
+  return n;
+}
+
+Rect gridRect(Rect c) {
+  return {c.x + 1, c.y + k_header, MinesState::k_columns * k_cell,
+          MinesState::k_rows * k_cell};
+}
+
+Rect faceRect(Rect c) { return {c.x + c.w / 2 - 10, c.y + 3, 20, 18}; }
+
+void drawFace(Band& b, Rect c, const MinesState& g) {
+  Rect f = faceRect(c);
+  mask(b, WinIcons::k_maskFace, f.x + 1, f.y, KDColor::RGB24(0xF5C518));
+  KDColor ink = KDColor::RGB24(0x3A2A00);
+  // Eyes
+  if (g.lost) {
+    fill(b, {f.x + 5, f.y + 5, 3, 1}, ink);
+    fill(b, {f.x + 6, f.y + 4, 1, 3}, ink);
+    fill(b, {f.x + 12, f.y + 5, 3, 1}, ink);
+    fill(b, {f.x + 13, f.y + 4, 1, 3}, ink);
+  } else {
+    fill(b, {f.x + 6, f.y + 5, 2, 3}, ink);
+    fill(b, {f.x + 12, f.y + 5, 2, 3}, ink);
+  }
+  // Mouth
+  if (g.won) {
+    fill(b, {f.x + 6, f.y + 11, 8, 1}, ink);
+    fill(b, {f.x + 7, f.y + 12, 6, 1}, ink);
+  } else if (g.lost) {
+    fill(b, {f.x + 7, f.y + 11, 6, 1}, ink);
+    fill(b, {f.x + 6, f.y + 12, 1, 1}, ink);
+    fill(b, {f.x + 13, f.y + 12, 1, 1}, ink);
+  } else {
+    fill(b, {f.x + 6, f.y + 11, 8, 1}, ink);
+  }
+}
+
+void draw(Band& b, Rect c, bool focused) {
+  const Palette& p = palette();
+  MinesState& g = s.mines;
+  fill(b, c, p.windowBack);
+  char buffer[16];
+  fmt(buffer, sizeof(buffer), "Mines %d",
+           MinesState::k_mines - flags(g));
+  text(b, buffer, c.x + 8, c.y + 5, p.text);
+  fmt(buffer, sizeof(buffer), "Time %d", g.seconds);
+  text(b, buffer, c.right() - 8, c.y + 5, p.text, Small, Align::Right);
+  drawFace(b, c, g);
+  constexpr KDColor numberColors[9] = {
+      KDColor::RGB24(0xFFFFFF), KDColor::RGB24(0x4FA3F7),
+      KDColor::RGB24(0x5CC56A), KDColor::RGB24(0xF2645A),
+      KDColor::RGB24(0xB07CF0), KDColor::RGB24(0xF59E3B),
+      KDColor::RGB24(0x36B5C9), KDColor::RGB24(0xDDDDDD),
+      KDColor::RGB24(0x999999)};
+  for (int y = 0; y < MinesState::k_rows; y++) {
+    for (int x = 0; x < MinesState::k_columns; x++) {
+      Rect r = {gridRect(c).x + x * k_cell, gridRect(c).y + y * k_cell, k_cell,
+                k_cell};
+      if (!r.intersects(b.clip())) {
+        continue;
+      }
+      uint8_t v = g.cells[index(x, y)];
+      if (v & k_open) {
+        fill(b, r, KDColor::RGB24(0x141414));
+        if (v & k_mine) {
+          fill(b, r.inset(1), KDColor::RGB24(0x7A1F1A));
+          roundFill(b, r.inset(4), 4, KDColor::RGB24(0x111111));
+        } else if (v & 0x0F) {
+          buffer[0] = '0' + (v & 0x0F);
+          buffer[1] = 0;
+          text(b, buffer, r.x + k_cell / 2, r.y + 1, numberColors[v & 0x0F],
+               Small, Align::Center);
+        }
+      } else {
+        fill(b, r, KDColor::RGB24(0x5A5F66));
+        fill(b, {r.x, r.y, r.w, 1}, KDColor::RGB24(0x6E747C));
+        fill(b, {r.x, r.y, 1, r.h}, KDColor::RGB24(0x6E747C));
+        fill(b, {r.x, r.bottom() - 1, r.w, 1}, KDColor::RGB24(0x3E4248));
+        fill(b, {r.right() - 1, r.y, 1, r.h}, KDColor::RGB24(0x3E4248));
+        if (v & k_flag) {
+          fill(b, {r.x + 7, r.y + 3, 1, 10}, KDColor::RGB24(0x222222));
+          fill(b, {r.x + 8, r.y + 3, 4, 4}, KDColor::RGB24(0xE84A3C));
+        }
+      }
+      if (focused && x == g.selX && y == g.selY) {
+        frame(b, r, p.accent);
+        frame(b, r.inset(1), p.accent);
+      }
+    }
+  }
+}
+
+void clickCell(int x, int y, bool right, Rect c) {
+  MinesState& g = s.mines;
+  if (right) {
+    toggleFlag(g, x, y);
+  } else {
+    reveal(g, x, y);
+  }
+  invalidate(c);
+}
+
+bool handleKey(Event e, Rect c) {
+  MinesState& g = s.mines;
+  Rect old = {gridRect(c).x + g.selX * k_cell, gridRect(c).y + g.selY * k_cell,
+              k_cell, k_cell};
+  if (e == Events::Left && g.selX > 0) {
+    g.selX--;
+  } else if (e == Events::Right && g.selX < MinesState::k_columns - 1) {
+    g.selX++;
+  } else if (e == Events::Up && g.selY > 0) {
+    g.selY--;
+  } else if (e == Events::Down && g.selY < MinesState::k_rows - 1) {
+    g.selY++;
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (g.lost || g.won) {
+      reset(g);
+      invalidate(c);
+    } else {
+      clickCell(g.selX, g.selY, false, c);
+    }
+    return true;
+  } else if (e == Events::Toolbox || e == Events::Backspace) {
+    clickCell(g.selX, g.selY, true, c);
+    return true;
+  } else {
+    return false;
+  }
+  invalidate(old);
+  invalidate({gridRect(c).x + g.selX * k_cell, gridRect(c).y + g.selY * k_cell,
+              k_cell, k_cell});
+  return true;
+}
+
+void click(int x, int y, bool right, Rect c) {
+  Rect face = faceRect(c).translated(-c.x, -c.y);
+  if (face.contains(x, y)) {
+    reset(s.mines);
+    invalidate(c);
+    return;
+  }
+  Rect grid = gridRect(c).translated(-c.x, -c.y);
+  if (grid.contains(x, y)) {
+    int cx = (x - grid.x) / k_cell;
+    int cy = (y - grid.y) / k_cell;
+    s.mines.selX = cx;
+    s.mines.selY = cy;
+    clickCell(cx, cy, right, c);
+  }
+}
+
+bool tick(Rect c) {
+  MinesState& g = s.mines;
+  if (!g.started || g.lost || g.won) {
+    return false;
+  }
+  uint16_t seconds = static_cast<uint16_t>(
+      Ion::Timing::millis() / 1000 - g.startTime);
+  if (seconds != g.seconds) {
+    g.seconds = seconds > 999 ? 999 : seconds;
+    invalidate({c.right() - 80, c.y, 80, k_header});
+    return true;
+  }
+  return false;
+}
