--- /dev/null
+++ b/epsilon/apps/home/win/shell.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <ion/events.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace Win {
+
+/* Something to start from the desktop: a calculator app, one of the
+ * Windows-OS window apps, or an external app (.nwa game). */
+struct Item {
+  enum class Kind : uint8_t { None, Builtin, Window, External };
+  Kind kind;
+  int16_t index;  // app index in AppsContainer, WindowApp, or external index
+  bool operator==(const Item& o) const {
+    return kind == o.kind && index == o.index;
+  }
+  bool isNone() const { return kind == Kind::None; }
+};
+
+constexpr Item k_noItem = {Item::Kind::None, 0};
+
+/* The Windows-OS desktop. All its state is static: it survives leaving the
+ * home app to run a calculator app or a game. */
+namespace Shell {
+
+// The home app became active: refresh the list of apps and games
+void enter();
+// The home app is going away
+void leave();
+// Returns true if the event was used
+bool handleEvent(Ion::Events::Event event);
+// Called every Escher tick (300 ms). Returns true to redraw.
+bool tick();
+// Draws everything that intersects the band
+void render(Band& band);
+// An app to open, set by handleEvent; the caller opens it right away
+Item takeLaunch();
+// Where invalidated rectangles go (the home view)
+void setInvalidator(void (*invalidate)(Rect));
+// Duration of the last screen update (Task manager)
+void setLastRedrawDuration(int ms);
+
+}  // namespace Shell
+
+}  // namespace Win
+}  // namespace Home
